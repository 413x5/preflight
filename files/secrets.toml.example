# PR-Agent secrets for the preflight bundle. install.sh installs this as
# ~/.config/preflight/.secrets.toml (chmod 600) and symlinks it into the pr-agent package's
# settings dir. The section is [openai] because that is the OpenAI-compatible transport any
# compatible endpoint uses - it does not mean the provider has to be OpenAI.
# Paste the API key between the quotes below.
[openai]
api_base = "__API_BASE__"
key      = ""
