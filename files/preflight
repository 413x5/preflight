#!/usr/bin/env bash
# preflight — local PR-style review of the current branch vs the remote default branch.
#
# Usage:  preflight [command] [args...]
#   command : review (default) | describe | improve | ask "<question>" | hook
#             --help / -h and --version / -V are handled before anything else.
#
#   hook    — verify that the content being committed was already reviewed. This is what a repo's
#             .githooks/pre-commit calls; it is read-only and never runs a review. See docs/DESIGN.md.
#
# Base (PREFLIGHT_BASE):
#   the ref the diff is taken against. Unset, it is resolved as origin/HEAD, then the remote's own
#   HEAD, then origin/main|master, then main|master. Set it to target anything else.
#
# Scope (PREFLIGHT_SCOPE):
#   worktree (default) — reviews committed + UNCOMMITTED + untracked changes, so you can
#                        iterate in the working tree and commit only once, when it's clean.
#   head               — reviews committed changes only (base...HEAD). Cannot be enforced by a
#                        pre-commit hook, which by construction runs before the commit exists.
#
# Artifacts (dir = PREFLIGHT_DIR, default .preflight), auto-excluded from git:
#   review -> review.md + review.json (+ review.meta.json, the hook's record of what was reviewed)
#   describe -> description.md | improve -> improve.md | ask -> answer.md
#
# The model/endpoint come from ~/.config/preflight/preflight.toml (any OpenAI-compatible endpoint;
# ClinePass is only the default). Plain-diff mode: prints to stdout and writes the files above.
# Never modifies your index/HEAD/history, and never posts to GitHub.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"

# The config directory, honouring PREFLIGHT_HOME exactly as install.sh defines it. Defining it once
# matters: the version lookup, the secrets relink, the hook helper and the review config URL all live
# here, and if only some of them honoured the override they could read different directories - the
# version from one tree, the config from another.
cfgdir="${PREFLIGHT_HOME:-${HOME:-}/.config/preflight}"

# An installed copy has no way to tell you what it is, which makes "did the bundle update on this
# machine?" unanswerable except by re-running install.sh and hoping. There was a real session where
# exactly that question went unanswered. One source of truth: files/VERSION, installed next to the
# config. Looked up beside the script first (a checkout, or a vendored copy) and then in the config
# dir - PREFLIGHT_HOME overrides that dir exactly as it does in install.sh, so a throwaway-prefix
# install can still report its version. `unknown` rather than an error: a missing VERSION should not
# make the tool unusable.
#
# ${HOME:-} and not $HOME: bash expands every word of the `for` list before the loop starts, so a
# bare $HOME is evaluated even when the FIRST candidate would have matched - and under `set -u` an
# unset HOME (`env -u HOME preflight --version`) would abort instead of printing a version. The
# example hook guards HOME for the same reason (REQ-HOOK-26); this is the same trap one level up.
bundle_version() {
  local cand
  for cand in "$here/VERSION" "$cfgdir/VERSION"; do
    if [ -f "$cand" ]; then
      head -n1 "$cand" 2>/dev/null || true
      return 0
    fi
  done
  printf 'unknown\n'
}

usage() {
  cat <<'EOF'
preflight — review the working tree (no commit, no GitHub round trip).

Usage:  preflight [command] [args...]

Commands:
  review (default)     review the working tree vs the base branch
                       -> .preflight/review.md + .preflight/review.json
  describe             generate a PR description -> .preflight/description.md
  improve              suggest concrete code changes -> .preflight/improve.md
  ask "<question>"     ask about the diff -> .preflight/answer.md
  hook                 verify that the content being committed was reviewed (used by the
                       repo's own .githooks/pre-commit; read-only, never runs a review)

Options:
  -h, --help           this text
  -V, --version        the installed bundle version

Environment:
  PREFLIGHT_BASE       ref to diff against (default: origin/HEAD, then the remote's HEAD,
                       then origin/main|master, then main|master)
  PREFLIGHT_SCOPE      worktree (default) | head  (head cannot be enforced by the hook)
  PREFLIGHT_DIR        artifact dir (default .preflight)
  PREFLIGHT_HOME       config dir (default ~/.config/preflight) - the toml, the
                       secrets relink and the hook helper are all read from here
  PREFLIGHT_SKIP=1     (hook only) bypass the commit check once

Config:  <dir>/preflight.toml, where <dir> is PREFLIGHT_HOME or ~/.config/preflight
         (any OpenAI-compatible endpoint; see README "Using another provider")
Loop:    preflight review && preflight-gate   (exit 0 = pass)
         preflight-gate --help                for the gate's exits and options
Docs:    https://github.com/413x5/preflight
EOF
}

cmd="review"
if [ "$#" -gt 0 ]; then cmd="$1"; shift; fi

# Answered before anything touches git or the config - including before ensure-link.sh is sourced
# below - so `preflight --help` works anywhere: outside a repository, and on a machine where the
# secrets relink helper wants to print something first. The ordering matters here because this is the
# first command a new user runs after installing.
case "$cmd" in
  -h|--help|help)          usage; exit 0 ;;
  -V|--version|version)    printf 'preflight %s\n' "$(bundle_version)"; exit 0 ;;
esac

if [ -f "${cfgdir}/ensure-link.sh" ]; then
  . "${cfgdir}/ensure-link.sh"
fi

# Reject an unknown command BEFORE resolving the base or touching git: otherwise a typo prints a
# base-resolution line and possibly a fetch first, which buries the one line that matters.
case "$cmd" in
  review|review_pr|describe|describe_pr|improve|improve_code|ask|ask_question|hook) ;;
  *) echo "preflight: unknown command '$cmd' (use review|describe|improve|ask; 'preflight --help' for the full list)" >&2; exit 2 ;;
esac

dir="${PREFLIGHT_DIR:-.preflight}"
scope="${PREFLIGHT_SCOPE:-worktree}"

# `hook` is a verifier, not a review: it must not fetch, snapshot or require a config. Dispatch it
# before any of that, because it runs on every commit.
#
# ${HOME:-} here and above, for the reason bundle_version documents: this script runs under `set -u`,
# and an unset HOME (`env -u HOME git commit` - the case REQ-HOOK-26 guards in the example hook) must
# degrade to "helper not found" and refuse the commit, not abort with "HOME: unbound variable". A
# bare $HOME made the outer helper panic before it could reach the guard the inner one has.
if [ "${cmd:-review}" = "hook" ]; then
  for cand in "$here/preflight-hook" "${cfgdir}/preflight-hook"; do
    if [ -f "$cand" ]; then exec sh "$cand" "$@"; fi
  done
  echo "preflight: hook: preflight-hook not found (looked next to this script and in ${cfgdir})" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo 'preflight: not inside a git repository' >&2; exit 1; }
cd "$root"
git rev-parse --verify -q HEAD >/dev/null 2>&1 || { echo 'preflight: repository has no commits yet' >&2; exit 3; }
git fetch --quiet origin 2>/dev/null || echo 'preflight: warning: could not fetch origin' >&2

# The base to diff against. First candidate that resolves to a commit wins:
#
#   1. PREFLIGHT_BASE, when set - the override, and the only way to deliberately target another ref.
#   2. origin/HEAD, the remote's own record of its default branch (a full clone creates it).
#   3. the remote's HEAD asked directly, because a `--single-branch` clone and a hand-added remote
#      never create the LOCAL origin/HEAD symref, so step 2 silently has nothing to read.
#   4. origin/main, origin/master, then main, master - the conventional names, remote first.
#
# Falling through to a bare `main` without checking (the old behaviour) was a real failure: in a
# repository whose default branch is not `main`, `git diff main...HEAD` was fatal, pr-agent exited 2
# with "No diff content received", and - worst of it - the artifact dir was left EMPTY. An empty
# artifact dir is exactly what the commit hook reports as "no review found", so a base-resolution
# failure turned into every later commit being blocked for a reason that had nothing to do with the
# commit. Failing here, loudly, is the difference between a wrong answer and a wrong answer with
# nothing to look at.
resolve_base() {
  local cand
  if [ -n "${PREFLIGHT_BASE:-}" ]; then
    if git rev-parse --verify -q "${PREFLIGHT_BASE}^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "${PREFLIGHT_BASE}"; return 0
    fi
    echo "preflight: PREFLIGHT_BASE='${PREFLIGHT_BASE}' does not resolve to a commit" >&2
    return 1
  fi
  cand="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || true)"
  case "$cand" in ''|'origin/HEAD') cand='' ;; esac
  if [ -z "$cand" ]; then
    # `ls-remote --symref` prints "ref: refs/heads/<default>\tHEAD" without needing the local symref.
    # Any failure (no network, no remote) simply falls through to the conventional names below.
    cand="$(git ls-remote --symref origin HEAD 2>/dev/null \
             | awk '/^ref:/ { sub("refs/heads/", "", $2); print "origin/" $2; exit }')" || cand=''
  fi
  if [ -n "$cand" ] && git rev-parse --verify -q "${cand}^{commit}" >/dev/null 2>&1; then
    printf '%s\n' "$cand"; return 0
  fi
  for cand in origin/main origin/master main master; do
    if git rev-parse --verify -q "${cand}^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "$cand"; return 0
    fi
  done
  return 1
}

base="$(resolve_base)" || {
  echo 'preflight: cannot tell which branch to diff against.' >&2
  echo 'preflight: looked for PREFLIGHT_BASE, origin/HEAD, the remote HEAD, then origin/main|master and main|master.' >&2
  echo 'preflight: name it explicitly, e.g.  PREFLIGHT_BASE=origin/develop preflight review' >&2
  exit 4
}
echo "preflight: base=${base}" >&2

# Ensure the artifact dir is git-ignored in THIS repo (per-repo git metadata, never committed),
# so the worktree snapshot below can't sweep the artifacts into the reviewed diff.
case "$dir" in
  /*|..|../*|*/../*|*/..) : ;;  # absolute or escaping path: leave excludes alone
  *)
    excl="$(git rev-parse --git-path info/exclude 2>/dev/null || true)"
    if [ -n "$excl" ] && ! grep -qxF "${dir}/" "$excl" 2>/dev/null; then
      printf '\n# preflight local review artifacts\n%s/\n' "$dir" >> "$excl" 2>/dev/null || true
    fi
    ;;
esac

idxf=''
hook_tree=''
cleanup() { if [ -n "$idxf" ]; then rm -f "$idxf"; fi; }
trap cleanup EXIT
if [ "$scope" = 'head' ]; then
  diff_ref="${base}...HEAD"
else
  idxf="$(mktemp)"; rm -f "$idxf"
  GIT_INDEX_FILE="$idxf" git read-tree HEAD
  GIT_INDEX_FILE="$idxf" git add -A
  tree="$(GIT_INDEX_FILE="$idxf" git write-tree)"
  # This tree is the exact content handed to pr-agent, so it is the record the commit hook
  # compares against. Captured here, on the same temp index, rather than recomputed later.
  hook_tree="$tree"
  synth="$(GIT_AUTHOR_NAME=preflight GIT_AUTHOR_EMAIL=preflight@localhost \
            GIT_COMMITTER_NAME=preflight GIT_COMMITTER_EMAIL=preflight@localhost \
            git -c commit.gpgsign=false commit-tree "$tree" -p HEAD -m 'preflight worktree snapshot')"
  diff_ref="${base}...${synth}"
fi

case "$cmd" in
  review|review_pr)     out_md="$dir/review.md";      out_json="$dir/review.json" ;;
  describe|describe_pr) out_md="$dir/description.md"; out_json='' ;;
  improve|improve_code) out_md="$dir/improve.md";     out_json='' ;;
  ask|ask_question)     out_md="$dir/answer.md";      out_json='' ;;
  *) echo "preflight: unknown command '$cmd' (use review|describe|improve|ask; 'preflight --help' for the full list)" >&2; exit 2 ;;
esac

mkdir -p "$dir"
cfg="file://${cfgdir}/preflight.toml"
echo "preflight: ${cmd} (scope=${scope}) — $(git rev-parse --abbrev-ref HEAD) vs ${base} -> ${dir}/" >&2

if [ -n "$out_json" ]; then
  git diff "$diff_ref" | pr-agent --extra_config_url "$cfg" --stdin \
    --output "$out_md" --json-output "$out_json" "$cmd" "$@"
else
  git diff "$diff_ref" | pr-agent --extra_config_url "$cfg" --stdin \
    --output "$out_md" "$cmd" "$@"
fi

echo "preflight: wrote ${out_md}${out_json:+ and ${out_json}}" >&2

# Record what was reviewed so the commit hook can verify it later. The hook reads gate.verdict,
# which comes from the same rules preflight-gate applies (kept in one place: the gate itself).
if [ "$cmd" = 'review' ] || [ "$cmd" = 'review_pr' ]; then
  if [ -n "$out_json" ] && [ -f "$out_json" ]; then
    verdict="fail"
    gate_code=0
    gate_bin=''
    for cand in "$(cd "$(dirname "$0")" && pwd)/preflight-gate" "${HOME:-}/.local/bin/preflight-gate"; do
      if [ -f "$cand" ]; then gate_bin="$cand"; break; fi
    done
    if [ -n "$gate_bin" ]; then
      # Run it with the interpreter its shebang names, NOT `sh`. preflight-gate is bash (`set -o
      # pipefail`), and on Debian/Ubuntu /bin/sh is dash, which rejects pipefail outright - the gate
      # died on its first line, the exit code was read as a failed verdict, and every commit was then
      # blocked with "the last review did not pass" for a reason unrelated to the review. Executing it
      # directly honours the shebang, and there is deliberately no `|| sh` fallback: that would
      # reintroduce exactly this silently-wrong verdict on any host where the shebang cannot be used.
      PREFLIGHT_DIR="$dir" "$gate_bin" >/dev/null 2>&1 || gate_code=$?
      if [ "$gate_code" = 126 ] || [ "$gate_code" = 127 ]; then
        echo "preflight: warning: could not execute ${gate_bin}; the gate verdict is unknown" >&2
      fi
    else
      gate_code=127
    fi
    [ "$gate_code" = "0" ] && verdict="pass"
    python3 - "$dir/review.meta.json" "$scope" "$dir" "$hook_tree" "$(git rev-parse HEAD)" "$verdict" "$gate_code" <<'PY' || true
import json, sys, datetime
path, scope, d, tree, head, verdict, code = sys.argv[1:8]
meta = {}
try:
    with open(path) as fh:
        meta = json.load(fh)
except Exception:
    meta = {}
meta.update({
    "scope": scope,
    "dir": d,
    "head": head,
    "reviewed_tree": tree,
    "generated_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "gate": {"verdict": verdict, "exit": int(code)},
})
with open(path, "w") as fh:
    json.dump(meta, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
    echo "preflight: recorded reviewed content for the commit hook (${verdict})" >&2
  fi
fi
if [ -n "$out_json" ] && [ -f "$out_json" ]; then
  python3 - "$out_json" "$out_md" <<'PY' >&2 2>/dev/null || true
import json, re, sys
d = json.load(open(sys.argv[1]))
r = d.get('review') or {}
issues = r.get('key_issues_to_review') or []
sec = (r.get('security_concerns') or '').strip()
line = (f"preflight: issues={len(issues)} security={sec or 'n/a'}"
        f" effort={r.get('estimated_effort_to_review_[1-5]')}"
        f" tokens={(d.get('usage') or {}).get('total_tokens')}")
# Coverage is part of the verdict, so report it next to the counts. A pruned diff means the model was
# shown part of the tree, and `issues=1` on a partial review does NOT mean "one problem in the change"
# - it means the rest was never looked at. That misreading is what turns a single review into an
# unbounded fix/re-review loop, so it belongs on the line an agent actually reads, not only in the
# markdown footer further down.
#
# Matching is the hard part, because the file being searched is model-generated prose and a finding may
# legitimately *discuss* coverage - a review of THIS feature did exactly that. Text matching alone cannot
# win: the model can reproduce the footer's words while explaining them. Attempts, in order:
#   - 'Review coverage:' alone - matched its own review, reporting PARTIAL for a fully-reviewed diff;
#   - two independent substrings - a finding quoted both and still tripped it;
#   - the footer's contiguous sentence - a verbatim quote still trips it;
#   - only searching after the review's last `</table>` - closer, but prose can still follow the table.
# What actually holds is matching pr-agent's FOOTER BLOCK as it EMITS it, not its prose: the footer is
# introduced by a horizontal rule and continues with the file bullets pr-agent generates
# (`"\n\n<hr>\n\n" + "⚠️ **Review coverage:** ... token budget:\n" + "- \`file\`" ...`). Requiring the
# `<hr>` anchor, the header, the sentence AND the bullet list makes this a match of the footer's emitted
# STRUCTURE - a finding would have to forge a horizontal rule and a bullet list of files to trip it,
# which is a far narrower accident than quoting a sentence. The tail-after-`</table>` restriction is
# kept as a second, independent condition.
#
# The limit, stated honestly: this is text matching, so a reproduction that is byte-faithful to the
# emitted footer is indistinguishable from the footer itself. What makes that acceptable rather than
# hand-waving is that the remaining ambiguity all points one way - a model writing the full footer,
# rule and bullets included, is either reproducing pr-agent's own output or writing something no real
# review does - and a miss is the safer error here: it degrades to the plain summary line, whereas a
# spurious PARTIAL is what teaches the reader to ignore the marker.
COVERAGE_RE = re.compile(
    r"<hr>\s*\n\s*\n?\s*\u26a0\ufe0f \*\*Review coverage:\*\* The following files were not included "
    r"in this review because of the token budget:\s*\n\s*-\s*`",
    re.S)
try:
    # errors='replace', not a bare read: the footer contains an emoji, so a review.md written in a
    # non-UTF-8 locale would raise UnicodeDecodeError - which is a ValueError, not an OSError, so the
    # except below would not catch it. The whole summary line would be lost (the outer `|| true`
    # swallows the traceback), taking the counts with it. Decoding leniently keeps them.
    md = open(sys.argv[2], encoding='utf-8', errors='replace').read()
except OSError:
    md = ''
# Everything a finding writes renders inside the table, and plain-diff mode always renders one. This
# restriction is LOAD-BEARING, not a nicety: the regex above matches the emitted structure, and a finding
# that quotes the footer verbatim reproduces exactly that structure, so only "it is inside the table"
# rejects it. REQ-HOOK-28 asserts that case, and removing this line is one of the listed mutations.
#
# It is not self-sufficient either - a review whose prose AFTER the table reproduces the rule and bullets
# would pass both conditions - but that requires forging pr-agent's generated output, whereas every
# observed false positive was a finding describing the footer. With no `</table>` (a shape plain-diff
# does not produce) the whole file is searched.
#
# Neither failure direction is acceptable, which is why both are tested: a miss retires the marker and a
# partial review reads as complete, while a spurious match fires it on a complete one and teaches the
# reader to ignore it. This line is an AID that points at the authoritative footer in review.md, not a
# guarantee - `review.md` is what to read to settle whether coverage was complete.
tail = md[md.rfind('</table>') + len('</table>'):] if '</table>' in md else md
if COVERAGE_RE.search(tail):
    line += " coverage=PARTIAL (token budget left files out - see review.md)"
print(line)
PY
fi
