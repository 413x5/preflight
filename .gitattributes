# Normalize line endings to LF in the repo and the working tree, so the helper
# scripts run as-is on any machine after a clone.
* text=auto eol=lf

# The helpers are shell scripts: text, LF-only.
*.sh                 text eol=lf
files/preflight      text eol=lf
files/preflight-hook text eol=lf
files/preflight-pr   text eol=lf
files/preflight-gate text eol=lf
files/githooks/*     text eol=lf
tests/run.sh         text eol=lf

*.toml text eol=lf
*.md   text eol=lf
