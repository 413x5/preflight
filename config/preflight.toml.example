# preflight config — a HOST-side PR-Agent layer, loaded via --extra_config_url.
#
# Any OpenAI-compatible endpoint works; these values are the ClinePass defaults the bundle was built
# for. install.sh overrides them all: PREFLIGHT_MODEL, PREFLIGHT_FALLBACK_MODELS,
# PREFLIGHT_CUSTOM_MODEL_MAX_TOKENS, PREFLIGHT_MAX_MODEL_TOKENS, PREFLIGHT_FORCE_STREAMING_HOST.
#
# Why each value is what it is: docs/architecture.md. History: CHANGELOG.md.
[config]
model = "openai/cline-pass/deepseek-v4.1-flash"
# An id your endpoint serves, in its own provider/model form ([] disables fallback).
fallback_models = ["openai/cline-pass/glm-5.3-flash"]
# Required when the model is absent from LiteLLM's table (as cline-pass/* is), or nothing declares the
# context window and the packing clamp cuts it to 32k. 0 = let LiteLLM resolve it.
custom_model_max_tokens = 1000000
max_model_tokens = 1000000
# Without this the ENDPOINT's own ceiling applies, and on this host that ceiling is low enough that a
# reasoning model can spend all of it thinking and return truncated YAML - which fails to parse, so the
# run silently falls through to `fallback_models` and answers with the weaker model. The failure is the
# one this bundle exists to prevent: the run looks clean while the configured model never answered.
# The numbers and the method are in docs/measurements.md. The reserve this implies is subtracted from
# `max_model_tokens` for prompt fitting, so the two have to leave room for the diff.
max_output_tokens = 384000
output_run_details = true

[litellm]
# CLINEPASS-SPECIFIC, matched against api_base so it is inert for other endpoints: this host's
# non-streaming envelope cannot be normalized by LiteLLM, its streaming returns standard SSE.
force_streaming_custom_llm_provider = "openai"
force_streaming_api_base_substrings = ["api.cline.bot"]
custom_llm_provider = "openai"

[pr_reviewer]
# The heading a review renders under, so a review can be told apart from any other markdown in the
# repository - or from another tool's comment on the same change. Upstream's default is plain
# `PR Reviewer Guide`, which says nothing about which tool produced it.
review_heading = "Preflight - PR Reviewer Guide"
# Upstream is 3, which makes an agent fix only 3 findings and can discover 3 more on the next run.
num_max_findings = 10

# The section's other knobs, at the values pr-agent ships - commented, so an untouched install tracks
# upstream rather than freezing today's defaults. Uncomment one to steer; the bundle's own settings are
# the live lines above, and tests/run.sh checks this list against the installed pr-agent.


# Enable/Disable features

# require_score_review = false
# require_tests_review = true
# require_estimate_effort_to_review = true
# require_can_be_split_review = false
# require_security_review = true
# require_estimate_contribution_time_cost = false
# require_todo_scan = false
# require_ticket_analysis_review = true


# Opt-in structured assessment fields. Each adds one field to the review output and to the model's output schema.

# require_risk_assessment = false # ask the model for an overall risk level (low/medium/high); the gate only prints it, and it measured unstable - see docs/roadmap.md
# require_merge_recommendation = false # ask the model for a merge recommendation (safe_to_merge/merge_with_caution/changes_required); off, so preflight-gate reports merge=n/a - see docs/architecture.md
# require_priority_files = false # ask the model which files a human should inspect first


# General options

# publish_output_no_suggestions = true # Set to "false" if you only need the reviewer's remarks (not labels, not "security audit", etc.) and want to avoid noisy "No major issues detected" comments.
# publish_error_details = false # Publish a deterministic, sanitized failure reason in manual review comments. No AI call is used.
# persistent_comment = true
# persistent_finding_state = true # Persist review finding state across complete review runs.
# inline_key_issues = false # Publish each review finding as an inline comment where the provider can verify inline-comment publication (GitHub, Bitbucket Cloud, Azure DevOps, GitLab).
# extra_instructions = "" # left empty deliberately: text here overrides pr-agent's own severity guidance - see docs/roadmap.md
# final_update_message = true
# review labels
# enable_review_labels_security = true
# enable_review_labels_effort = true
# specific configurations for incremental review (/review -i)
# require_all_thresholds_for_incremental_review = false
# minimal_commits_for_incremental_review = 0
# minimal_minutes_for_incremental_review = 0
# enable_intro_text = true
# enable_help_text = false # Determines whether to include help text in the PR review.
# enable_review_coverage_footer = true
# large-diff chunking (opt-in). When the token budget leaves files out of the review, split the diff
# into chunks, review each chunk, and merge the per-chunk results into one review.
# enable_large_pr_chunking = false
# max_number_of_calls = 3 # maximum number of chunk review calls, used only when enable_large_pr_chunking is true
