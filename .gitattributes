# Normalize line endings to LF in the repo and the working tree, so the helper
# scripts run as-is on any machine after a clone.
* text=auto eol=lf

# The helpers are shell scripts: text, LF-only.
*.sh                 text eol=lf
src/preflight-code   text eol=lf
src/preflight-hook   text eol=lf
src/preflight-pr     text eol=lf
src/preflight-gate   text eol=lf
src/githooks/*       text eol=lf
scripts/*            text eol=lf
tests/run.sh         text eol=lf

*.toml text eol=lf
*.md   text eol=lf
