# Remove this run's output path(s) BEFORE launching, for every command. For `review` it is also what
# makes phase 1 below wait for THIS run's artifact (a stale file would make the wait return immediately
# with the previous review's counts). For `describe`/`improve`/`ask` it is what makes the archived and
# top-level artifact provably this run's: those commands only overwrite their output when pr-agent
# actually writes it, so without this a pr-agent that exits 0 having produced nothing would leave the
# PREVIOUS run's file in place, and archive_run would file it - and `run.json` would claim it - as this
# run's output.
rm -f "$out_md" ${out_json:+"$out_json"} 2>/dev/null || true

# Run the review in the background and report its counts from the artifact, so a pr-agent that finishes
# the review and then hangs on shutdown cannot hide `issues=`/`new=`/`coverage=`. Two bounded phases,
# because a hang can happen before OR after the artifacts are written.
if [ -n "$out_json" ]; then
  git diff ${diff_base:+"$diff_base"} "$diff_ref" | pr-agent --extra_config_url "$cfg" --stdin \
    --output "$out_md" --json-output "$out_json" "$cmd" "$@" &
  pr_pid=$!

  # Phase 1: the review. `kill -0` tests liveness without reaping, so the exit status survives.
  waited=0
  review_limit="${PREFLIGHT_REVIEW_WAIT:-3600}"
  # Anything but a plain number means the default: `[` would otherwise report an error on every
  # iteration and scroll a working review off the screen. The step is its own variable and is read as
  # base 10, because arithmetic reads `5m` as an invalid number, `abc` as 0, and `08` as octal.
  step="${PREFLIGHT_PROGRESS_EVERY:-30}"
  case "$step" in
    ''|*[!0-9]*) step=30 ;;
  esac
  step=$((10#$step))
  next_note="$step"
  while { [ ! -f "$out_json" ] || [ ! -f "$out_md" ]; } \
        && kill -0 "$pr_pid" 2>/dev/null && [ "$waited" -lt "$review_limit" ]; do
    sleep 1
    waited=$((waited + 1))
    # An hour-long silence cannot be told apart from a wedged run: the operator sees no output either way,
    # and the only way to find out is to wait for the bound. This says WHICH phase it is in and how long it
    # has been there, so a stuck endpoint reads as one. stderr only - stdout is the summary the loop parses.
    if [ "$next_note" -gt 0 ] && [ "$waited" -ge "$next_note" ]; then
      printf 'preflight-code: pr-agent is still running (%ss, no review written yet)\n' "$waited" >&2
      next_note=$((next_note + step))
    fi
  done

  emit_summary

  # Phase 2: the shutdown - bounded and short, because the review is already on disk by now.
  shutdown_waited=0
  shutdown_limit="${PREFLIGHT_SHUTDOWN_WAIT:-120}"
  while kill -0 "$pr_pid" 2>/dev/null && [ "$shutdown_waited" -lt "$shutdown_limit" ]; do
    sleep 1
    shutdown_waited=$((shutdown_waited + 1))
  done

  complete=''
  if [ -f "$out_json" ] && [ -f "$out_md" ]; then complete=1; fi

  stopped=''
  if kill -0 "$pr_pid" 2>/dev/null; then
    stopped=1
    run_stopped=1
    if [ -n "$complete" ]; then
      printf 'preflight-code: warning: pr-agent did not exit within %ss after writing %s; stopping it (the review is complete and usable)\n' \
        "$shutdown_limit" "$out_json" >&2
    else
      printf 'preflight-code: warning: pr-agent did not exit within %ss and did not write %s; stopping it (this run produced no review)\n' \
        "$shutdown_limit" "$out_json" >&2
    fi
    kill -TERM "$pr_pid" 2>/dev/null || true
    hold=0
    while kill -0 "$pr_pid" 2>/dev/null && [ "$hold" -lt 5 ]; do sleep 1; hold=$((hold + 1)); done
    kill -KILL "$pr_pid" 2>/dev/null || true
  fi

  pr_status=0
  wait "$pr_pid" 2>/dev/null || pr_status=$?
  # The child is reaped, so its pid is free to be reused: cleanup() must not signal whoever gets it next.
  pr_pid=''

  # A process WE stopped after a complete review is not a failure - `preflight-gate` decides the verdict
  # on the artifact. Anything else (including a stopped run that wrote nothing) keeps its own status, so a
  # bad key, a real error, or a hang that produced no review still fails the run.
  if [ -n "$stopped" ] && [ -n "$complete" ]; then
    case "$pr_status" in
      143|137) pr_status=0 ;;
    esac
  fi

  [ -n "$complete" ] && emit_summary
  [ "$pr_status" = 0 ] || exit "$pr_status"
  run_ok=1
else
  # describe/improve/ask write no JSON artifact, so there is nothing to salvage: they are not bounded, and
  # a timeout must never cut off slow-but-valid work.
  git diff ${diff_base:+"$diff_base"} "$diff_ref" | pr-agent --extra_config_url "$cfg" --stdin \
    --output "$out_md" "$cmd" "$@" &
  pr_pid=$!
  rc=0
  wait "$pr_pid" 2>/dev/null || rc=$?
  # Reaped: the pid is free to be reused, so cleanup() must not signal whoever gets it next. Cleared
  # before the exit, because that exit is the other path cleanup() runs on.
  pr_pid=''
  [ "$rc" = 0 ] || exit "$rc"
  run_ok=1
fi
echo "preflight-code: wrote ${out_md}${out_json:+ and ${out_json}}" >&2

# Record what was reviewed so the commit hook can verify it later. The hook reads gate.verdict,
# which comes from the same rules preflight-gate applies (kept in one place: the gate itself).
if [ "$cmd" = 'review' ] || [ "$cmd" = 'review_pr' ]; then
  if [ -n "$out_json" ] && [ -f "$out_json" ]; then
    verdict="fail"
    gate_code=0
    gate_bin=''
    for cand in "$(cd "$(dirname "$0")" && pwd)/preflight-gate" "${HOME:-}/.local/bin/preflight-gate"; do
      if [ -f "$cand" ]; then gate_bin="$cand"; break; fi
    done
    if [ -n "$gate_bin" ]; then
      # Execute it directly so its shebang is honoured, NEVER via `sh`: preflight-gate is bash (`set -o
      # pipefail`) and on Debian/Ubuntu /bin/sh is dash, which rejects pipefail outright - the gate died
      # on its first line and its exit code was read as a failed verdict, blocking every commit for a
      # reason unrelated to the review. Deliberately no `|| sh` fallback, which would reintroduce that.
      PREFLIGHT_DIR="$dir" "$gate_bin" >/dev/null 2>&1 || gate_code=$?
      if [ "$gate_code" = 126 ] || [ "$gate_code" = 127 ]; then
        echo "preflight-code: warning: could not execute ${gate_bin}; the gate verdict is unknown" >&2
      fi
    else
      gate_code=127
    fi
    [ "$gate_code" = "0" ] && verdict="pass"
    run_verdict="$verdict"
    # Removed immediately before the write, for the same provenance reason as the artifacts above: the
    # write below is guarded, so if it fails the PREVIOUS run's sidecar would otherwise still be here -
    # and archive_run would file it, with this run's verdict in run.json beside the older verdict in the
    # file. A missing sidecar is the honest outcome: the commit hook then fails closed with "no review
    # found", which is correct for a review that could not record what it covered.
    rm -f "$dir/review.meta.json" 2>/dev/null || true
    python3 - "$dir/review.meta.json" "$scope" "$dir" "$hook_tree" "$(git rev-parse HEAD)" "$verdict" "$gate_code" <<'PY' || true
