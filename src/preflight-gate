#!/usr/bin/env bash
# preflight-gate — machine-checkable gate over the latest PR-Agent review.
#
#   preflight-gate [path-to-review.json]   (default: ${PREFLIGHT_DIR:-.preflight}/review.json)
#
# Exit: 0 = pass | 1 = key issues | 2 = security concerns | 3 = no review
# Config:  [gate] in $PREFLIGHT_HOME/settings.toml, then [gate] in ./.preflight.toml (repo, overrides)
# Env:  PREFLIGHT_GATE_ALLOW_ISSUES=1  ignore key issues (security still applies)
#       PREFLIGHT_GATE_DOC_BLOCKS=1    count documentation findings as blocking (default: advisory)
set -euo pipefail
json="${1:-${PREFLIGHT_DIR:-.preflight}/review.json}"

# The gate is what a coding agent loops on, so its exits and its two opt-outs have to be answerable
# from the command itself rather than only from the bundle's docs.
case "${1:-}" in
  -h|--help|help)
    cat <<'EOF'
preflight-gate — machine check over the latest review (default .preflight/review.json).

Usage:  preflight-gate [review.json]

Exit:   0  pass
        1  key issues present
        2  security concerns present
        3  no review yet (run 'preflight-code review' first)

Environment:
  PREFLIGHT_GATE_ALLOW_ISSUES=1   ignore key issues (security concerns still fail). Waived findings are
                                  labelled `[waived]` and counted, so a PASS they produced is not
                                  mistaken for a review with nothing to say
  PREFLIGHT_GATE_DOC_BLOCKS=1     count findings on documentation as blocking

Configuration:
  Optional, and every key has a built-in default. Two files are read, the later overriding the
  earlier, and the environment variables above override both. The keys live in a [gate] table, so
  one file carries both the review's settings and the gate's policy:

    $PREFLIGHT_HOME/settings.toml   machine-wide (default ~/.config/preflight/settings.toml)
    <repo>/.preflight.toml          repo-local (at the repository root), for policy that differs
                                    per repository; the same file carries the review's own overrides

  Keys: doc_suffixes (list), doc_blocks (bool), allow_issues (bool).

Findings on a documentation file (`.md`, `.markdown`, `.rst`, `.adoc` by default - see
`doc_suffixes`) are ADVISORY by default: they are printed and counted, but they do not fail the gate,
so a typo in a README does not fail the gate on its own (security concerns still fail regardless). Any
other path - including code under `docs/`, or a `requirements.txt` - blocks.
EOF
    exit 0 ;;
esac

if [ ! -f "$json" ]; then echo "preflight-gate: no review at $json (run 'preflight-code review' first)" >&2; exit 3; fi
python3 - "$json" <<'PY'
import json, os, re, sys

# ---- policy -------------------------------------------------------------------------------------
# The gate's tunables come from an optional TOML file (home, then a repo-local override), with the
# environment taking precedence, because the environment is what a one-off invocation can set without
# editing a file. Every value has a built-in default, so no config file is required to run.
#
# TOML is parsed with `tomllib`, which is stdlib from Python 3.11. On an older interpreter that import
# fails, and a hard dependency would mean the gate cannot run at all - and an unrunnable gate fails
# closed, i.e. it would block every commit on that machine. So a failed import degrades to "no config
# file", which is exactly the built-in defaults.
try:
    import tomllib
except ImportError:
    tomllib = None

DEFAULTS = {
    # Prose formats. `.txt` is deliberately absent: `requirements.txt` is a dependency manifest, and a
    # finding there ("this pin is vulnerable") must keep failing the gate. `.mdx` is absent too - it is
    # Markdown plus executable JSX, so a component bug belongs to code. A misclassified prose file
    # blocks, which is the safe direction; `doc_suffixes` in a config file is how a repo that differs
    # says so.
    'doc_suffixes': ('.md', '.markdown', '.rst', '.adoc'),
    'doc_blocks': False,
    'allow_issues': False,
}

def _repo_local():
    # The repository's file is resolved at its ROOT, so the gate finds the same file whether it is run
    # from the root or a subdirectory - and `preflight-code review` already runs it from the root. Outside a
    # repository there is nothing to override, and the cwd is the honest fallback.
    try:
        import subprocess
        top = subprocess.run(['git', 'rev-parse', '--show-toplevel'],
                             capture_output=True, text=True, timeout=10)
        root = top.stdout.strip()
    except Exception:
        root = ''
    return os.path.join(root or '.', '.preflight.toml')

def _config_files():
    home = os.environ.get('PREFLIGHT_HOME') or os.path.expanduser('~/.config/preflight')
    # The gate's keys live in a [gate] table of the SAME files the review reads, so a repository carries
    # one `.preflight.toml` and the machine one `settings.toml`. The repo-local file is deliberately NOT
    # under `.preflight/`: pr-agent owns that directory through `--output`/`--json-output`.
    return [os.path.join(home, 'settings.toml'), _repo_local()]

def _retired_files():
    home = os.environ.get('PREFLIGHT_HOME') or os.path.expanduser('~/.config/preflight')
    return [os.path.join(home, 'gate.toml'), os.path.join(os.path.dirname(_repo_local()), '.preflight-gate.toml')]

def _warn(message):
    print(f'preflight-gate: warning: {message}', file=sys.stderr)

# ONE rule, applied in ONE place: a value that is present but invalid is reported and the value already
# in force is kept. That direction matters - the alternative (drop the key, or fall back to a hardcoded
# default) silently changes enforcement, which is how a repo comes to believe its policy is loaded when
# it is not. Each key names only how to validate its OWN value; the reporting and the fallback are not
# per-key, which is what stops a new key from inventing its own failure behaviour.
_INVALID = object()

def _validate_bool(value):
    if isinstance(value, bool):
        return value, None
    # Only the integer mirror is accepted, and only 0/1: TOML parses a bare `1` as an int, so
    # `doc_blocks = 1` mirrors the environment variable. Any other number (`2`, `-1`, `nan`) or a float
    # is not a boolean, and treating it as true would be the unsafe direction on `allow_issues`.
    if isinstance(value, int):
        if value in (0, 1):
            return value == 1, None
        return _INVALID, 'not a boolean'
    if isinstance(value, str) and value.strip().lower() in ('1', 'true', 'yes', 'on', '0', 'false', 'no', 'off'):
        return value.strip().lower() in ('1', 'true', 'yes', 'on'), None
    return _INVALID, 'not a boolean'

# A suffix must be a string, and the RESULT must look like one extension. This is a whitelist, not a
# list of rejected cases: anything that does not match is invalid, which is what makes the domain
# finitely testable. The rejected cases are worth naming because each was a bug: an empty string
# (`endswith('')` matches every path), a dotless `"txt"` (matches `notes.baktxt`), a path fragment
# (`endswith('docs/')` matches everything under it), and a non-string entry like `1`, which `str()`
# would otherwise coerce into the plausible-looking suffix `.1`.
_SUFFIX_RE = re.compile(r'^\.[a-z0-9][a-z0-9._+-]*$')

def _validate_suffixes(value):
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, (list, tuple)):
        return _INVALID, 'not a list of suffixes'
    kept = []
    added_dot = 0
    for entry in value:
        if not isinstance(entry, str):
            return _INVALID, f'{entry!r} is not a string'
        text = entry.strip().lower()
        # ANY empty entry invalidates the whole list, rather than being dropped with the rest applied: a
        # list the writer got wrong is one value, and partially honouring it is the kind of silent
        # difference this rule exists to avoid.
        if not text:
            return _INVALID, 'an empty entry is not a file extension'
        if not text.startswith('.'):
            text = '.' + text
            added_dot += 1
        if not _SUFFIX_RE.match(text):
            return _INVALID, f'{text!r} is not a file extension'
        kept.append(text)
    if not kept:
        return _INVALID, 'no usable suffixes'
    if added_dot:
        return tuple(kept), f'added a leading dot to {added_dot} entr{"y" if added_dot == 1 else "ies"}'
    return tuple(kept), None

_VALIDATORS = {
    'doc_suffixes': _validate_suffixes,
    'doc_blocks': _validate_bool,
    'allow_issues': _validate_bool,
}

def _apply(cfg, key, source, value):
    validated, note = _VALIDATORS[key](value)
    if validated is _INVALID:
        _warn(f'ignoring {key} in {source}: {note} (keeping {cfg[key]!r})')
        return
    if note:
        _warn(f'{key} in {source}: {note}')
    cfg[key] = validated

def _merge(cfg, source, values):
    if not isinstance(values, dict):
        return
    for key, value in values.items():
        # An unknown key is reported, not silently kept: a typo'd key name is how a policy looks
        # configured while doing nothing.
        if key not in _VALIDATORS:
            _warn(f'ignoring unknown key {key!r} in {source}')
            continue
        _apply(cfg, key, source, value)

def _read_file(cfg, path):
    if tomllib is None:
        # No stdlib TOML on this interpreter (Python < 3.11), so the gate must still run - but a file
        # that is present and ignored is the same "policy never loaded" case every other path reports.
        if os.path.exists(path):
            _warn(f'ignoring {path}: this python3 has no tomllib (3.11+), so the policy file cannot be read')
        return
    try:
        with open(path, 'rb') as fh:
            loaded = tomllib.load(fh)
    except FileNotFoundError:
        return
    except OSError as exc:
        _warn(f'ignoring unreadable config {path}: {exc}')
        return
    except Exception:
        # Malformed TOML. A crash is a non-zero exit, which the commit hook reads as "the review did
        # not pass" - so the previous values stay in force and the file is reported.
        _warn(f'ignoring unparseable config {path}')
        return
    # Only [gate] is the gate's policy. The rest of the file is the review's configuration, which the
    # renderer reads and this process must not: a [pr_reviewer] key is not a typo, and reporting it as an
    # unknown gate key would train the reader to ignore this warning.
    if not isinstance(loaded, dict):
        _warn(f'ignoring config {path}: no table at the top level')
        return
    section = loaded.get('gate')
    if section is None:
        return
    if not isinstance(section, dict):
        _warn(f'ignoring [gate] in {path}: it is not a table')
        return
    _merge(cfg, path, section)

def _read_retired():
    # The files this policy lived in before it moved into a [gate] table. A present one is NOT read - its
    # keys are in the wrong place now - but silence over one that SETS keys would leave a policy looking in
    # force while the built-in defaults decided the verdicts, so it is reported by name. An inert file
    # parses to `{}` and stays quiet: that is exactly what the old install wrote, and nothing was lost.
    for path in _retired_files():
        if not os.path.exists(path):
            continue
        if tomllib is None:
            _warn(f'{path} is no longer read: the gate keys live in a [gate] table of settings.toml/.preflight.toml')
            continue
        try:
            with open(path, 'rb') as fh:
                loaded = tomllib.load(fh)
        except Exception:
            _warn(f'{path} is no longer read, and could not be parsed: move its keys into a [gate] table '
                  'of settings.toml (machine-wide) or .preflight.toml (this repository)')
            continue
        if loaded:
            _warn(f'{path} sets keys that are no longer read: move them into a [gate] table '
                  'of settings.toml (machine-wide) or .preflight.toml (this repository)')

def load_policy():
    cfg = dict(DEFAULTS)
    _read_retired()
    for path in _config_files():
        _read_file(cfg, path)
    # The environment is applied last, through the same validator, so a one-off override cannot behave
    # differently from the file value it replaces.
    for key, var in (('allow_issues', 'PREFLIGHT_GATE_ALLOW_ISSUES'),
                     ('doc_blocks', 'PREFLIGHT_GATE_DOC_BLOCKS')):
        if os.environ.get(var):
            _apply(cfg, key, var, os.environ[var])
    return cfg

# ---- finding fields -----------------------------------------------------------------------------

# The review is model output, so each field's JSON type is whatever the model chose. Coerce every
# field to text: a crash here is not a neutral failure - the hook reads any non-zero exit as "did not
# pass" and `preflight-code review` records it as the sidecar verdict, so a type quirk becomes a blocked
# commit for a clean review.
def as_text(v):
    if v is None:
        return ''
    if isinstance(v, bool):
        return 'yes' if v else 'no'
    # A falsy non-bool (0, [], {}) means "nothing here", matching the `(field or '')` idiom this
    # replaced: without it, `security_concerns: 0` became the STRING '0', which `is_no` does not
    # recognise, so a clean review exited 2 and blocked commits.
    if not v:
        return ''
    return str(v).strip()

try:
    with open(sys.argv[1]) as fh:
        d = json.load(fh)
except Exception as exc:
    # Exit 3 is "no usable review", which is what an unreadable one amounts to; a traceback would be
    # indistinguishable from a genuine gate failure.
    print(f'preflight-gate: cannot read {sys.argv[1]}: {exc}', file=sys.stderr)
    sys.exit(3)

POLICY = load_policy()
# Guard the SHAPE as well as the parse: valid JSON that is not a review object (`[1,2,3]`, or
# `"review": "..."`) crashed with an AttributeError and blocked commits the same way. A wholly ABSENT
# `review` key keeps its meaning (no findings, fields n/a), but a key present and not an object -
# including an explicit `null` - is malformed and reported rather than passed over: this is the
# enforcement gate, so "the model returned no review
# object" must not read as "the review was clean".
if not isinstance(d, dict):
    print(f'preflight-gate: {sys.argv[1]} is not a review object (JSON {type(d).__name__})', file=sys.stderr)
    sys.exit(3)
if 'review' in d:
    r = d['review']
    if not isinstance(r, dict):
        print(f'preflight-gate: {sys.argv[1]} has a non-object "review" (JSON {type(r).__name__})', file=sys.stderr)
        sys.exit(3)
else:
    r = {}
eff = r.get('estimated_effort_to_review_[1-5]')
risk = as_text(r.get('risk_level'))
tests = as_text(r.get('relevant_tests'))
issues = r.get('key_issues_to_review')
# The last field without a guard, and the one this file's whole stance is about: a truthy non-list
# (`true`, `3`) survives `or []` and then breaks `len()` and the loop below, which is another
# uncaught traceback - and therefore another clean review recorded as `fail` that blocks commits.
# Absent or empty keeps its long-standing meaning; anything that is not a list is reported, not
# iterated.
if issues is None:
    issues = []
if not isinstance(issues, list):
    print(f'preflight-gate: {sys.argv[1]} has a non-list "key_issues_to_review" ({type(issues).__name__})', file=sys.stderr)
    sys.exit(3)
sec = as_text(r.get('security_concerns'))
is_no = lambda v: v.lower() in ('', 'no', 'none', 'n/a', 'false')

# A finding's severity is deterministic, derived from its FILE TYPE, because the model's schema has no
# severity field to read (see docs/architecture.md). A documentation file is advisory wherever it lives, and
# code under `docs/` (a Sphinx `conf.py`, a build script) keeps blocking - a location rule would make the
# tier defeatable by the directory a file sits in.
DOC_SUFFIXES = POLICY['doc_suffixes']

def is_doc(path):
    return as_text(path).lower().endswith(DOC_SUFFIXES)

def finding_path(it):
    return as_text(it.get('relevant_file')) if isinstance(it, dict) else ''

# Reading the file is what the gate is FOR, so the caller sees every finding and the tier that decided
# its fate; the `blocking=/advisory=` split then makes the verdict legible from the line alone.
tiers = ['advisory' if is_doc(finding_path(it)) else 'blocking' for it in issues]
# Advisory by default, so a doc typo does not fail the gate on its own; `doc_blocks` makes the strict
# behaviour - what
# the gate did before this tier existed - a config value away. The override rewrites the TIERS, not only
# the counters, so a promoted finding is labelled `[blocking]` on the line the reader sees: a label that
# disagreed with the exit code would be worse than no label (found by reviewing this with the tool).
if POLICY['doc_blocks']:
    tiers = ['blocking'] * len(issues)
# The same rule for the other opt-out: with key issues waived, a finding that no longer fails the gate
# must not still be labelled as if it did. Leaving the label alone is the bug the doc_blocks override
# above was written to avoid, so  gets the same treatment instead of a different one.
if POLICY['allow_issues']:
    tiers = ['waived' if t == 'blocking' else t for t in tiers]
n_blocking = tiers.count('blocking')
n_advisory = tiers.count('advisory')
n_waived = tiers.count('waived')

line = (f"preflight-gate: effort={eff} risk={risk or 'n/a'} tests={tests or 'n/a'}"
        f" issues={len(issues)}")
if n_advisory or n_waived:
    line += f" blocking={n_blocking} advisory={n_advisory} waived={n_waived}"
line += f" security={'yes' if not is_no(sec) else 'no'}"
print(line)
for it, tier in zip(issues, tiers):
    if isinstance(it, dict):
        print(f"preflight-gate:   - {as_text(it.get('relevant_file'))}: {as_text(it.get('issue_header'))} [{tier}]")
    else:
        print(f"preflight-gate:   - {as_text(it)} [{tier}]")
# Effort is REPORTED, never enforced: it is the model's own estimate, and a ceiling on it decided
# verdicts from a number the review did not have to be right about. Security and blocking findings are
# the properties the gate decides on.
#
# The merge recommendation is not read either: pr-agent emits it only when the repository asks
# `require_merge_recommendation`, which the bundle leaves off, so a rule on it would have nothing to read
# in a default install.
if not is_no(sec):
    print('preflight-gate: FAIL security concerns present'); sys.exit(2)
if issues and n_blocking and not POLICY['allow_issues']:
    print('preflight-gate: FAIL key issues present'); sys.exit(1)
if n_advisory:
    # Reported even on a pass: the findings are real, they are simply not fatal, and `doc_blocks` (or
    # `PREFLIGHT_GATE_DOC_BLOCKS=1`) is how the reader asks for them to be.
    print(f'preflight-gate: note: {n_advisory} advisory finding(s) on documentation did not fail the gate')
if n_waived:
    # The waiver is an explicit opt-out, so say so: a reader seeing `PASS` otherwise cannot tell that a
    # key issue was reported and discarded.
    print(f'preflight-gate: note: {n_waived} key issue(s) waived (allow_issues)')
print('preflight-gate: PASS'); sys.exit(0)
PY
