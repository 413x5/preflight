# Set the PREVIOUS review aside before this run overwrites it, so the summary can report whether the
# run surfaced anything NEW - the loop's convergence signal. The loop's failure mode is not "the model
# misses bugs" but "the model keeps reporting concerns that are already answered", because each round
# reviews the text the previous round wrote (comments, docs, guards) and a reviewer cannot tell a
# deliberate, documented trade-off from an oversight. Counting only what is new gives it a stopping rule.
# review is the only command that writes a json artifact, so this is inert for describe/improve/ask.
prev_json=''
if [ -n "$out_json" ] && [ -f "$out_json" ]; then
  # Assign only after a SUCCESSFUL copy: `mktemp` already created the file, so a failed copy must clean
  # up itself - the EXIT trap only removes a non-empty path, so it would otherwise leak a file per failure.
  cand="$(mktemp)"
  if cp "$out_json" "$cand" 2>/dev/null; then prev_json="$cand"; else rm -f "$cand"; fi
fi

# Report the counts from the artifact, so they survive a hang. Called from both points, hence idempotent:
# the flag is set only on a successful read, so an artifact caught mid-write does not retire the retry.
emit_summary() {
  [ -z "${summary_printed:-}" ] || return 0
  [ -f "$out_json" ] || return 0
  local rc=0
  PREFLIGHT_PREV_JSON="$prev_json" \
    PREFLIGHT_CONTEXT_NOTE="$context_note" \
    python3 - "$out_json" "$out_md" <<'PY' >&2 2>/dev/null || rc=$?
import json, os, re, sys
d = json.load(open(sys.argv[1]))
# The review is model output, so guard the SHAPE of the containers too, not only the values inside them:
# a `review` or `usage` that is not an object (a string, list, int) raised on `.get` and lost the whole
# line. preflight-gate exits 3 on a malformed review, which is what decides the verdict - so falling back
# here keeps the counts visible without softening anything the gate enforces.
def mapping(value):
    return value if isinstance(value, dict) else {}
r = mapping(d.get('review'))
usage = mapping(d.get('usage'))
# `len()` on a non-list is not just a wrong count: `"no issues"` reports 9, and an int or bool raises,
# which kills the heredoc and takes `issues=`, `new=` and `coverage=` with it. preflight-gate exits 3 on
# a non-list for the same reason; the summary cannot exit, so it falls back to an empty list and the line
# still prints. An explicit null keeps its meaning as "no findings".
_raw_issues = r.get('key_issues_to_review')
issues = _raw_issues if isinstance(_raw_issues, list) else []
# Every field on this line is read by an agent, so an absent or wrongly-typed one degrades to n/a rather
# than printing a bare `None`, raising, or reading as a verdict of its own. A raise is the worst of the
# three: it kills the heredoc, so `issues=`, `new=` and `coverage=` are lost together. Coercion matches
# preflight-gate's own `as_text`, including the boolean case - `security_concerns: true` is common enough
# that the gate has a dedicated guard for it.
#
# `merge_recommendation` and `risk_level` are REPORTED and never enforced: the gate decides on security
# concerns and blocking findings. `risk_level` measured unstable across identical content (see
# docs/measurements.md), and `merge_recommendation` is conditional on a key the bundle leaves off, so it
# is usually absent. They stay on the line because they tell a reader what the model thought, not because
# a verdict depends on them.
def as_text(value):
    if value is None:
        return ''
    if isinstance(value, bool):
        return 'yes' if value else 'no'
    if not value:
        return ''
    return str(value).strip()
sec = as_text(r.get('security_concerns'))
risk = as_text(r.get('risk_level'))
rec = as_text(r.get('merge_recommendation'))
effort = as_text(r.get('estimated_effort_to_review_[1-5]'))
tokens = as_text(usage.get('total_tokens'))
line = (f"preflight-code: issues={len(issues)} security={sec or 'n/a'}"
        f" risk={risk or 'n/a'} merge={rec or 'n/a'}"
        f" effort={effort or 'n/a'} tokens={tokens or 'n/a'}")
# Whether repository context reached the model, on the line an agent reads: a review fed the repo's own
# facts is not the same review as one that was not, and nothing else in the output distinguishes them.
context_note = os.environ.get('PREFLIGHT_CONTEXT_NOTE') or 'none'
if context_note != 'none':
    line += f" context={context_note}"
# Coverage belongs on the line an agent actually reads: a pruned diff means the model saw part of the
# tree, so `issues=1` does NOT mean "one problem in the change". Reported only for the branch scopes.
#
# The match is against pr-agent's FOOTER BLOCK as it EMITS it - the `<hr>` anchor, the bold header, the
# sentence and the generated `- \`file\`` bullets - not any single sentence, which a finding can quote
# verbatim by accident. A byte-faithful reproduction is indistinguishable from the footer; a miss
# degrades to the plain summary line, which is the safer error (a spurious PARTIAL teaches the reader
# to ignore the marker).
COVERAGE_RE = re.compile(
    # `[^\n]*` rather than the emoji, which the lenient read below may have replaced with U+FFFD: requiring
    # the emoji would make the marker unable to fire on exactly the file it was written to tolerate, and
    # would make pr-agent's choice of pictograph load-bearing.
    r"<hr>\s*\n\s*[^\n]*\*\*Review coverage:\*\*\s*The following files were not included in this "
    r"review because of the token budget:\s*\n\s*-\s*`",
    re.S)
# Whether the CONFIGURED model answered, or a fallback did. pr-agent tries `config.model` and only then
# `fallback_models`, recording the winner in run details - which reach the review as prose, NOT as a
# field in review.json (checked against v0.47.0: the JSON carries only `review` and `usage`). So this is
# read from review.md, and the line it reads is the one pr-agent writes for every review, not a shape
# invented here. It matters because a fallback answer is a different model's judgement presented as the
# configured one - a run that looked at home in the bundle's own output while the model it was set up
# for never answered.
FALLBACK_RE = re.compile(r"^- Models?: .*\((?:includes fallback|fallback)\)", re.M)
try:
    # errors='replace', not a bare read: a non-UTF-8 review.md would raise UnicodeDecodeError - a
    # ValueError, not an OSError, so the except below would not catch it - and the outer `|| true` would
    # swallow the traceback, losing the counts too, not just the marker.
    md = open(sys.argv[2], encoding='utf-8', errors='replace').read()
except OSError:
    md = ''
# LOAD-BEARING: every finding renders inside the table, so this rejects a finding that quotes the footer
# verbatim (REQ-HOOK-28; removing this line is one of the listed mutations). Not self-sufficient - prose
# after the table could reproduce the footer - but that requires forging pr-agent's own output. With no
# `</table>` the whole file is searched. This is an AID pointing at the authoritative footer in
# review.md, not a guarantee.
tail = md[md.rfind('</table>') + len('</table>'):] if '</table>' in md else md
# Reported for EVERY scope, not only the branch ones. It was once gated on the branch scopes, on the
# reasoning that a pending-commit diff is far below the token budget - which holds for ordinary changes and
# fails for a large one (a multi-megabyte generated or untracked file before the first commit). Since the
# bundle does not chunk, pruning is what pr-agent does to an over-budget diff, so the marker is the only
# thing that says a commit-scope review covered a slice. Suppressing it there would hide exactly the
# partial review the marker exists to announce.
if COVERAGE_RE.search(tail):
    line += " coverage=PARTIAL (token budget left files out - see review.md)"
# A fallback model answering is not the same review as the configured one answering, and nothing else on
# this line says which happened - `context=` tells an agent the repository facts reached the model, so
# which model is not a detail it can assume. Read from the post-table tail for the same reason as coverage:
# findings render inside the table, so a finding that quotes the run-details block cannot fire this.
if FALLBACK_RE.search(tail):
    line += " model=FALLBACK (the configured model did not answer - see review.md)"

# How many findings are NEW since the previous review. Identity is (file, header, content) per
# pr-agent's own dedupe key, so a different issue in the same file still counts as new. temperature and
# seed are deliberately NOT set, so a reworded repeat still reads as new - the honest limit of a
# mechanical count. `new=0` with issues>0 means stop and read the findings, not fix them.
#
# Gated on "a previous review was LOADED", not on "it had findings": a clean previous review makes every
# current finding new, and suppressing the count there would remove the signal from the round most likely
# to be re-running for no reason.
new = None
prev_path = os.environ.get('PREFLIGHT_PREV_JSON') or ''
if prev_path and os.path.isfile(prev_path):
    def key(issue):
        if not isinstance(issue, dict):
            return ('', '', str(issue))

        def norm(value):
            return ' '.join(str(value or '').split()).lower()

        return (norm(issue.get('relevant_file')), norm(issue.get('issue_header')),
                norm(issue.get('issue_content')))
    try:
        with open(prev_path, encoding='utf-8') as fh:
            prev = json.load(fh).get('review') or {}
        seen = {key(i) for i in (prev.get('key_issues_to_review') or [])}
        new = sum(1 for i in issues if key(i) not in seen)
    except Exception:
        new = None
if new is not None:
    line += f" new={new}/{len(issues)}"
    if issues and new == 0:
        # "repeats the previous review" is a statement about the text, not a verdict that the finding is
        # handled: an agent that deliberately deferred one (judged it wrong, or ran out of time) will see
        # it again here. The wording therefore points at the judgement to make rather than declaring done.
        line += " (unchanged since the previous review: judge each, do not re-fix blind)"
print(line)
PY
  # Always return 0: a function's status propagates under `set -e`, so a failed read would abort the run
  # instead of deferring to the retry after the process exits.
  [ "$rc" = 0 ] && summary_printed=1
