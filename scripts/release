#!/usr/bin/env bash
# scripts/release — cut a release: bump the version, draft the changelog entry, commit the bump under
# `chore(release)`, and create the signed annotated tag.
#
#   scripts/release 0.4.0        # bump and tag
#   scripts/release --check      # validate the tree without changing anything
#
# What it derives, and what it leaves to you. The bump is a release-script job; the *entry* is not. The
# script moves whatever is under `[Unreleased]` into the new version's section, so you write the prose
# first, read it, and only then run this - drafting words from commit subjects is the part a person is
# better at, and a release entry is read by a user, not by a reviewer of this repository.
#
# It NEVER pushes. Publishing is a separate, deliberate act: `git push origin main && git push origin
# vX.Y.Z`, then create the release. A tag that has left this clone is never moved or deleted, so the
# push is the point of no return and is not something a script should do on your behalf.
#
# `--no-gpg-sign` exists for a machine with no signing key. It prints what it did and that the tag is
# unverified, because a silent unsigned release in a repository whose commits are signed is a
# difference someone would otherwise have to discover from `git tag -v`.
set -uo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here" || exit 1

rc=0
check_only=0
sign=1
version=""

usage() {
  cat <<'EOF'
Usage: scripts/release <X.Y.Z> [--check] [--no-gpg-sign]

  --check         validate everything, create nothing
  --no-gpg-sign   create an unsigned annotated tag (prints a warning)

Refuses on a dirty tree, on a checkout that is not on the trunk, on a version
that is not greater than the current one, and on a tag that already exists.
EOF
}

for a in "$@"; do
  case "$a" in
    -h|--help|help) usage; exit 0 ;;
    --check) check_only=1 ;;
    --no-gpg-sign) sign=0 ;;
    -*) echo "release: unknown option '$a'" >&2; usage >&2; exit 2 ;;
    *) [ -z "$version" ] || { echo "release: one version at a time" >&2; exit 2; }; version="$a" ;;
  esac
done

say() { printf '%s\n' "$*" >&2; }
die() { printf 'release: %s\n' "$*" >&2; exit 1; }

# ---- refusal conditions, before anything is written --------------------------------------------
[ -n "$version" ] || { usage >&2; exit 2; }
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) die "'$version' is not X.Y.Z" ;;
esac

[ -f src/VERSION ] || die "src/VERSION not found; run this from the repository root"
current="$(head -n1 src/VERSION)"

# Numeric comparison, not string: 0.10.0 is greater than 0.9.0, and `sort -V` is not POSIX everywhere.
greater() {
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n1)" = "$1" ]
}
greater "$version" "$current" || die "$version is not greater than the current $current"

git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

# The tag must name a commit on the trunk: a release tagged off a side branch is not the released
# history, and the tag cannot be moved once pushed.
trunk=""
for cand in main master; do
  git show-ref --verify -q "refs/heads/$cand" && { trunk="$cand"; break; }
done
[ -n "$trunk" ] || die "no main or master branch here"
branch="$(git rev-parse --abbrev-ref HEAD)"
[ "$branch" = "$trunk" ] || die "on '$branch', not '$trunk' - the tag must name a commit on $trunk"

if [ -n "$(git status --porcelain)" ]; then
  git status --short >&2
  die "working tree is dirty; commit or stash first"
fi

git rev-parse -q --verify "refs/tags/v$version" >/dev/null && die "tag v$version already exists"

grep -q '^## \[Unreleased\]' CHANGELOG.md || die "CHANGELOG.md has no '## [Unreleased]' section"
grep -q "^## \[$version\]" CHANGELOG.md && die "CHANGELOG.md already has a [$version] section"
grep -q "^\[Unreleased\]: " CHANGELOG.md || die "CHANGELOG.md has no [Unreleased] compare link"
grep -q "^\[$current\]: " CHANGELOG.md || die "CHANGELOG.md has no [$current] link to rewrite"

# The Unreleased section must actually say something: an empty release is a version bump with nothing
# behind it, and `_(nothing yet)_` shipping as a release is worse than not releasing.
if sed -n '/^## \[Unreleased\]/,/^## \[/p' CHANGELOG.md | grep -q '_(nothing yet)_'; then
  die "'[Unreleased]' is still the placeholder - write the entry before releasing"
fi

date_utc="$(date -u +%Y-%m-%d)"
say "release: $current -> $version ($date_utc), trunk '$trunk'"

if [ "$check_only" = 1 ]; then
  say "check: ok (nothing written)"
  exit 0
fi

# ---- the edits ---------------------------------------------------------------------------------
# 1. Version: the single source of truth, read by `--version`, `install.sh`, and the gate's `version`
#    stage - which is also what makes the heading below a hard requirement rather than a convention.
printf '%s\n' "$version" > src/VERSION

# 2. Promote the Unreleased heading to the release, open a fresh empty one above it, and move the link
#    table with it: [Unreleased] now compares against the new tag, and the new tag gets its own link.
python3 - "$version" "$date_utc" "$current" <<'PY' || exit 1
import re, sys
version, date, prev = sys.argv[1:4]
path = "CHANGELOG.md"
s = open(path, encoding="utf-8").read()
base = "https://github.com/413x5/preflight"

# The heading: promote in place, so the [Unreleased] entry becomes the release's entry verbatim.
s, n = re.subn(r"^## \[Unreleased\]$",
               f"## [Unreleased]\n\n_(nothing yet)_\n\n## [{version}] - {date}",
               s, count=1, flags=re.M)
if n != 1:
    sys.exit("could not promote the [Unreleased] heading")

# [Unreleased] now compares the new tag against HEAD.
s, n = re.subn(r"^\[Unreleased\]: .*$",
               f"[Unreleased]: {base}/compare/v{version}...HEAD", s, count=1, flags=re.M)
if n != 1:
    sys.exit("could not rewrite the [Unreleased] compare link")

# The new version's link goes ABOVE the previous one, which keeps the table newest-first.
anchor = f"[{prev}]: {base}/releases/tag/v{prev}"
s, n = re.subn("^" + re.escape(anchor) + "$",
               f"[{version}]: {base}/releases/tag/v{version}\n" + anchor,
               s, count=1, flags=re.M)
if n != 1:
    sys.exit(f"could not insert the [{version}] link above [{prev}]")

open(path, "w", encoding="utf-8").write(s)
PY

# The gate fails on a version whose heading is missing, so assert the same thing here rather than
# discover it on the release commit.
grep -q "^## \[$version\] - $date_utc" CHANGELOG.md || die "the [$version] heading was not written"
grep -q "^\[$version\]: " CHANGELOG.md || die "the [$version] link was not written"

# ---- commit and tag ----------------------------------------------------------------------------
git add src/VERSION CHANGELOG.md
git commit -q -m "chore(release): $version" -m "Version $current -> $version. The entry is in CHANGELOG.md.

Run: scripts/verify -> gate: PASS." || die "commit failed"

tag_args=""
if [ "$sign" = 0 ]; then
  tag_args="--no-sign"
fi
# Annotated, never lightweight: the changelog entry is the tag message, so `git show vX.Y.Z` answers
# "what is in this release" without the repository.
note="$(mktemp)"
sed -n "/^## \[$version\]/,/^## \[/p" CHANGELOG.md | sed '$d' > "$note"
git tag $tag_args -a "v$version" -F "$note" || { rm -f "$note"; die "tagging failed"; }
rm -f "$note"

if [ "$sign" = 0 ]; then
  say "WARNING: tagged unsigned (--no-gpg-sign). Every other commit here is signed; say so if you publish it."
fi

say ""
say "Committed and tagged locally. Nothing was pushed."
say "  tag: v$version  ($(git rev-parse --short "v$version^{commit}"))"
say ""
say "To publish (deliberate, and not reversible - a pushed tag is never moved):"
say "  git push origin $trunk && git push origin v$version"
say "  gh release create v$version --title \"v$version\" --notes-from-tag"
