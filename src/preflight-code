#!/usr/bin/env bash
# preflight-code — local PR-style review of the pending change (or, optionally, the whole branch).
#
# Usage:  preflight-code [command] [args...]
#   command : review (default) | describe | improve | ask "<question>" | hook
#             --help / -h and --version / -V are handled before anything else.
#
#   hook    — verify that the content being committed was already reviewed. This is what a repo's
#             .githooks/pre-commit calls; it is read-only and never runs a review. See docs/architecture.md.
#
# Scope (PREFLIGHT_SCOPE):
#   commit (default)   — the pending change: HEAD -> working tree, untracked files included (a commit
#                        contains only staged content; this is a superset of it). No remote, no base,
#                        no fetch, and it is what the hook enforces.
#   worktree           — the whole BRANCH: default branch -> working tree. Needs a resolvable base
#                        (PREFLIGHT_BASE overrides it) and a fetch.
#   head               — committed changes only (base...HEAD). Not enforceable by a pre-commit hook,
#                        which by construction runs before the commit exists.
#
# Reviews are per-commit, which covers a multi-commit branch: each commit is checked against the tree
# reviewed for it, so their union covers the branch.
#
# Artifacts (dir = PREFLIGHT_DIR, default .preflight), auto-excluded from git:
#   review -> review.md + review.json (+ review.meta.json, the hook's record of what was reviewed)
#   describe -> description.md | improve -> improve.md | ask -> answer.md
#
# Those paths always hold the LATEST run, because that is what the commit hook and preflight-gate read.
# Every run that SUCCEEDS AND WRITES OUTPUT is also kept under runs/<UTC-start>-<pid>/ - a run.json
# (start, finish, duration, artifacts) beside copies of that run's artifacts - so the next run cannot
# destroy the last one. A run that failed, or that finished without writing anything, has no entry:
# every entry is a run whose output can be read. Nothing prunes them; delete a directory to drop a run.
#
# The model and endpoint come from ~/.config/preflight/settings.toml + providers.toml (any
# OpenAI-compatible endpoint). Plain-diff mode: prints to stdout and writes the files above.
# Never modifies your index/HEAD/history, and never posts to GitHub.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"

# PREFLIGHT_HOME is honoured here exactly as install.sh defines it. Defining it once matters: the
# version lookup, the rendered config and the hook helper all use it, and if only
# some honoured the override they could read different directories.
cfgdir="${PREFLIGHT_HOME:-${HOME:-}/.config/preflight}"

# VERSION is the single source of truth for the bundle version, installed next to the config: looked up
# beside the script first (a checkout or vendored copy), then in cfgdir. `unknown` rather than an error,
# because a missing VERSION should not make the tool unusable.
#
# ${HOME:-} and not $HOME: bash expands every word of the `for` list before the loop starts, so a bare
# $HOME is evaluated even when the FIRST candidate would have matched - and under `set -u` an unset HOME
# (`env -u HOME preflight-code --version`) would abort instead of printing a version. The example hook guards
# HOME for the same reason (REQ-HOOK-26).
bundle_version() {
  local cand
  for cand in "$here/VERSION" "$cfgdir/VERSION"; do
    if [ -f "$cand" ]; then
      head -n1 "$cand" 2>/dev/null || true
      return 0
    fi
  done
  printf 'unknown\n'
}

usage() {
  cat <<'EOF'
preflight-code — review the pending change (no commit, no GitHub round trip).

Usage:  preflight-code [command] [args...]

Commands:
  review (default)     review the pending change (HEAD -> working tree, no base)
                       -> .preflight/review.md + .preflight/review.json
  describe             generate a PR description -> .preflight/description.md
  improve              suggest concrete code changes -> .preflight/improve.md
  ask "<question>"     ask about the diff -> .preflight/answer.md
  hook                 verify that the content being committed was reviewed (used by the
                       repo's own .githooks/pre-commit; read-only, never runs a review)

  Those paths hold the latest run. Every run that succeeds and writes output is also kept, with its
  start time, finish time and duration, under .preflight/runs/<id>/run.json (nothing prunes them).

Options:
  -h, --help           this text
  -V, --version        the installed bundle version

Environment:
  PREFLIGHT_BASE       ref to diff against (default: origin/HEAD, then the remote's HEAD,
                       then origin/main|master, then main|master)
  PREFLIGHT_SCOPE      commit (default) | worktree | head
                       commit  = the pending change (HEAD -> worktree); enforced by the hook
                       worktree= the whole branch vs the default branch; enforced by the hook
                       head    = committed changes only; cannot be enforced by the hook
  PREFLIGHT_DIR        artifact dir (default .preflight)
  PREFLIGHT_HOME       config dir (default ~/.config/preflight) - settings.toml,
                       providers.toml and the hook helper are all read from here
  PREFLIGHT_CONTEXT_FILE  file whose "Code review" section is sent as reviewer context
                       (default AGENTS.md; a repo-local file, relative to the repo root)
  PREFLIGHT_SKIP=1     (hook only) bypass the commit check once
  PREFLIGHT_REVIEW_WAIT   seconds to wait for a review to produce its artifact (default 3600)
  PREFLIGHT_PROGRESS_EVERY seconds between "still running" notes on stderr while no review has been
                          written yet (default 30; 0 disables them); a stuck endpoint otherwise looks
                          identical to a slow one until the wait expires
  PREFLIGHT_SHUTDOWN_WAIT seconds to wait for pr-agent to EXIT after the artifact exists
                          (default 120); on expiry it is stopped and the run still succeeds,
                          because the review is already complete and preflight-gate decides
                          the verdict. See docs/runbooks/troubleshooting.md ("never exits").

Config:  <dir>/settings.toml + <dir>/providers.toml, where <dir> is PREFLIGHT_HOME or
         ~/.config/preflight
         (any OpenAI-compatible endpoint; see README "Using a different endpoint")
         <dir>/settings.toml names model configurations; <dir>/providers.toml holds the
         endpoints and keys they name. When one is assigned, `preflight-code` renders both
         into the config pr-agent reads. A repository may override review and [gate]
         settings in its own ./.preflight.toml. See README "Per-repository settings, and the gate's policy".
Loop:    preflight-code review && preflight-gate   (exit 0 = pass)
         preflight-gate --help                for the gate's exits and options
Docs:    https://github.com/413x5/preflight
EOF
}

cmd="review"
if [ "$#" -gt 0 ]; then cmd="$1"; shift; fi

# Answered before anything touches git or the config below, so
# `preflight-code --help` works outside a repository and does not depend on the config being readable.
case "$cmd" in
  -h|--help|help)          usage; exit 0 ;;
  -V|--version|version)    printf 'preflight-code %s\n' "$(bundle_version)"; exit 0 ;;
esac

# The model configuration. Sourced from beside the script first (a checkout or vendored copy), then from
# cfgdir, the two places install.sh puts it. Without the helper nothing can be rendered, so the run is
# refused rather than left to pr-agent's own defaults - the same silent-wrong-model failure the resolver
# refuses when it cannot parse the file at all.
__preflight_load_settings_render() {
  local cand
  # Names this command in the renderer's refusals. Set before sourcing so the shared resolver never has
  # to guess which of the two helpers is speaking.
  __preflight_caller_name='preflight-code'
  for cand in "$here/settings-render.sh" "$here/../scripts/settings-render.sh" "${cfgdir}/settings-render.sh"; do
    if [ -f "$cand" ]; then
      . "$cand"
      return 0
    fi
  done
  if [ -f "${cfgdir}/settings.toml" ]; then
    printf 'preflight-code: %s is present, but settings-render.sh was not found (looked beside this script and in %s)\n' \
      "${cfgdir}/settings.toml" "$cfgdir" >&2
    printf 'preflight-code: refusing to review with a model configuration that was not applied\n' >&2
  else
    printf 'preflight-code: neither settings-render.sh nor %s was found (looked beside this script and in %s)\n' \
      "${cfgdir}/settings.toml" "$cfgdir" >&2
    printf 'preflight-code: install.sh writes both; re-run it, or point PREFLIGHT_HOME at an install that has them\n' >&2
  fi
  return 2
}

# Reject an unknown command BEFORE resolving the base or touching git: otherwise a typo prints a
# base-resolution line and possibly a fetch first, which buries the one line that matters.
case "$cmd" in
  review|review_pr|describe|describe_pr|improve|improve_code|ask|ask_question|hook) ;;
  *) echo "preflight-code: unknown command '$cmd' (use review|describe|improve|ask; 'preflight-code --help' for the full list)" >&2; exit 2 ;;
esac

dir="${PREFLIGHT_DIR:-.preflight}"
scope="${PREFLIGHT_SCOPE:-commit}"
case "$scope" in
  commit|worktree|head) ;;
  *) echo "preflight-code: unknown PREFLIGHT_SCOPE '$scope' (expected commit, worktree or head)" >&2; exit 2 ;;
esac

# `hook` is a verifier, not a review: it must not fetch, snapshot or require a config. Dispatch it
# before any of that, because it runs on every commit.
#
# ${HOME:-} here and above, for the reason bundle_version documents: under `set -u` an unset HOME
# (`env -u HOME git commit` - the case REQ-HOOK-26 guards in the example hook) must degrade to "helper
# not found" and refuse the commit, not abort with "HOME: unbound variable".
if [ "${cmd:-review}" = "hook" ]; then
  for cand in "$here/preflight-hook" "${cfgdir}/preflight-hook"; do
    if [ -f "$cand" ]; then exec sh "$cand" "$@"; fi
  done
  echo "preflight-code: hook: preflight-hook not found (looked next to this script and in ${cfgdir})" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo 'preflight-code: not inside a git repository' >&2; exit 1; }
cd "$root"
git rev-parse --verify -q HEAD >/dev/null 2>&1 || { echo 'preflight-code: repository has no commits yet' >&2; exit 3; }
# The branch scopes need an up-to-date base, and a remote to get it from; `commit` needs neither, so it
# makes no network round trip and works offline. This also removes base-resolution failures from the
# common path.
if [ "$scope" != 'commit' ]; then
  git fetch --quiet origin 2>/dev/null || echo 'preflight-code: warning: could not fetch origin' >&2
fi

# The base to diff against. First candidate that resolves to a commit wins:
#
#   1. PREFLIGHT_BASE, when set - the override, and the only way to deliberately target another ref.
#   2. origin/HEAD, the remote's own record of its default branch (a full clone creates it).
#   3. the remote's HEAD asked directly, because a `--single-branch` clone and a hand-added remote
#      never create the LOCAL origin/HEAD symref, so step 2 silently has nothing to read.
#   4. origin/main, origin/master, then main, master - the conventional names, remote first.
#
# Falling through to a bare `main` without checking (the old behaviour) was a real failure: in a
# repository whose default branch is not `main`, `git diff main...HEAD` was fatal and pr-agent exited 2
# with "No diff content received", leaving the artifact dir EMPTY - which the commit hook reports as
# "no review found", so a base-resolution failure blocked every later commit. Fail here instead.
resolve_base() {
  local cand
  if [ -n "${PREFLIGHT_BASE:-}" ]; then
    if git rev-parse --verify -q "${PREFLIGHT_BASE}^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "${PREFLIGHT_BASE}"; return 0
    fi
    echo "preflight-code: PREFLIGHT_BASE='${PREFLIGHT_BASE}' does not resolve to a commit" >&2
    return 1
  fi
  cand="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null || true)"
  case "$cand" in ''|'origin/HEAD') cand='' ;; esac
  if [ -z "$cand" ]; then
    # `ls-remote --symref` prints "ref: refs/heads/<default>\tHEAD" without needing the local symref.
    # Any failure (no network, no remote) simply falls through to the conventional names below.
    cand="$(git ls-remote --symref origin HEAD 2>/dev/null \
             | awk '/^ref:/ { sub("refs/heads/", "", $2); print "origin/" $2; exit }')" || cand=''
  fi
  if [ -n "$cand" ] && git rev-parse --verify -q "${cand}^{commit}" >/dev/null 2>&1; then
    printf '%s\n' "$cand"; return 0
  fi
  for cand in origin/main origin/master main master; do
    if git rev-parse --verify -q "${cand}^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "$cand"; return 0
    fi
  done
  return 1
}

if [ "$scope" = 'commit' ]; then
  base='HEAD'
else
  base="$(resolve_base)" || {
    echo 'preflight-code: cannot tell which branch to diff against.' >&2
    echo 'preflight-code: looked for PREFLIGHT_BASE, origin/HEAD, the remote HEAD, then origin/main|master and main|master.' >&2
    echo 'preflight-code: name it explicitly, e.g.  PREFLIGHT_BASE=origin/develop preflight-code review' >&2
    echo "preflight-code: or use PREFLIGHT_SCOPE=commit to review only the pending change." >&2
    exit 4
  }
  echo "preflight-code: base=${base}" >&2
fi

# Ensure the artifact dir is git-ignored in THIS repo (per-repo git metadata, never committed),
# so the worktree snapshot below can't sweep the artifacts into the reviewed diff.
case "$dir" in
  /*|..|../*|*/../*|*/..) : ;;  # absolute or escaping path: leave excludes alone
  *)
    excl="$(git rev-parse --git-path info/exclude 2>/dev/null || true)"
    if [ -n "$excl" ] && ! grep -qxF "${dir}/" "$excl" 2>/dev/null; then
      printf '\n# preflight local review artifacts\n%s/\n' "$dir" >> "$excl" 2>/dev/null || true
    fi
    ;;
esac

idxf=''
prev_json=''
hook_tree=''
diff_base=''
run_id=''
run_dir=''
run_started=''
run_ok=''
run_stopped=''
run_verdict=''
# The rendered model configuration's path, set once the render succeeds. Initialised here with the rest so
# every reference is defined under `set -u`, including on exit paths that never reach the render; cleanup()
# is what deletes the file, so it holds the key for exactly the length of the run.
rendered_cfg=''

# The run history. One directory per run under `runs/`, so the fixed top-level paths can stay "the
# latest run" for the commit hook and preflight-gate while the previous run survives the `rm -f` that
# starts a new one. Written from the EXIT trap rather than from the success path, so the record covers
# every way a GOOD run ends - including one pr-agent stalled on and was stopped after the review was
# already complete. A run that failed is not archived at all; archive_run says why.
begin_run() {
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  run_dir="$dir/runs/$run_id"
  # Epoch seconds, so `duration_seconds` is arithmetic on the same clock as `finished_at` and the two
  # cannot disagree about where the run began. Captured before the diff is built and before pr-agent is
  # launched, so the number covers the whole run rather than only the model call.
  run_started="$(date +%s)"
}

archive_run() {
  [ -n "$run_dir" ] || return 0
  # Only a run that SUCCEEDED is archived. The obvious "did the artifact appear?" test is not enough on
  # its own: pr-agent may write a partial file and then fail, and filing that as a completed run would
  # present half an answer as the run's output. A failed run is therefore not recorded at all - the
  # output path is removed before the launch, so nothing of it survives at the fixed path either.
  [ -n "$run_ok" ] || return 0
  # Checked BEFORE the directory is created: a run directory without a run.json would break the
  # documented `cat .preflight/runs/*/run.json` for that run, contradicting the warning below.
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'preflight-code: warning: python3 not found, so this run was not recorded under %s/runs\n' "$dir" >&2
    return 0
  fi
  local now arts='' landed='' f
  now="$(date +%s)"
  # These two paths are per-command (out_md is description.md / improve.md / answer.md for the others),
  # so a name is never hardcoded here - which is also why the sidecar below needs its own guard.
  if [ -n "$out_md" ] && [ -f "$out_md" ]; then arts="$arts $(basename "$out_md")"; fi
  if [ -n "$out_json" ] && [ -f "$out_json" ]; then arts="$arts $(basename "$out_json")"; fi
  # Only `review` writes a sidecar, so describe/improve/ask must not pick up the one a previous review
  # left at the fixed path.
  case "$cmd" in
    review|review_pr) if [ -f "$dir/review.meta.json" ]; then arts="$arts review.meta.json"; fi ;;
  esac

  # The same "not recorded" warning as the two branches around it: a silent drop here would leave the
  # history incomplete with nothing to say so, which is the failure mode this whole record exists to
  # avoid. Nothing about the run itself is affected - the caller still sees `preflight-code: wrote ...`.
  mkdir -p "$run_dir" 2>/dev/null || {
    printf 'preflight-code: warning: could not create %s; the run is not recorded in the history\n' "$run_dir" >&2
    return 0
  }
  for f in $arts; do
    if cp "$dir/$f" "$run_dir/$f" 2>/dev/null && [ -f "$run_dir/$f" ]; then landed="$landed $f"; fi
  done
  # Nothing was actually written, so leave nothing behind: an empty directory reads as a run whose
  # artifacts went missing rather than as one that never wrote any.
  if [ -z "$landed" ]; then
    rmdir "$run_dir" 2>/dev/null || true
    return 0
  fi

  # Not inside `$( )`: the heredoc body sits in a command substitution otherwise, which is the macOS
  # bash 3.2 mis-parse AGENTS.md documents.
  #
  # A directory holding artifacts but no run.json would break the documented
  # `cat .preflight/runs/*/run.json`, so a write that produced no file is not tolerated: the directory is
  # removed and the operator is told, the same way the missing-python3 case above behaves. Nothing here
  # changes the run's own exit status - the review already succeeded, and failing it over a bookkeeping
  # file would turn a good run into a blocked commit.
  if ! python3 - "$run_dir/run.json" "$run_id" "$cmd" "$scope" "$run_started" "$now" \
                "${run_stopped:+yes}" "$run_verdict" "$landed" <<'PY'
import json, sys, datetime
path, run_id, command, scope, started, finished, stopped, verdict, landed = sys.argv[1:10]

def utc(epoch):
    return datetime.datetime.fromtimestamp(int(epoch), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

# No `status` field: only a run that succeeded is archived at all, so a status could only ever read
# `ok`, and a constant is a claim a reader would have to verify rather than a fact the record carries.
record = {
    "id": run_id,
    "command": command,
    "scope": scope,
    "started_at": utc(started),
    "finished_at": utc(finished),
    "duration_seconds": int(finished) - int(started),
    "stopped": stopped == "yes",
    "artifacts": landed.split(),
}
# Absent rather than empty on a run that recorded no verdict, so a reader cannot mistake `null` for a
# gate that failed.
if verdict:
    record["gate"] = {"verdict": verdict}
with open(path, "w") as fh:
    json.dump(record, fh, indent=2, sort_keys=True)
    fh.write("\n")
PY
  then
    printf 'preflight-code: warning: could not write %s; the run is not recorded in the history\n' "$run_dir/run.json" >&2
    rm -rf "$run_dir" 2>/dev/null || true
    return 0
  fi
  [ -s "$run_dir/run.json" ] || {
    printf 'preflight-code: warning: %s is missing or empty; the run is not recorded in the history\n' "$run_dir/run.json" >&2
    rm -rf "$run_dir" 2>/dev/null || true
    return 0
  }
  return 0
}

cleanup() {
  if [ -n "$idxf" ]; then rm -f "$idxf"; fi
  if [ -n "$prev_json" ]; then rm -f "$prev_json"; fi
  # An abnormal exit (an arithmetic error under `set -e`, a signal) would otherwise leave pr-agent
  # running. It holds the caller's stdout open, so `x="$(preflight-code review)"` blocks for the model call
  # even though this script is long gone - the failure looks like a hang in the wrong process.
  if [ -n "${pr_pid:-}" ] && kill -0 "$pr_pid" 2>/dev/null; then
    kill -TERM "$pr_pid" 2>/dev/null || true
    hold=0
    while kill -0 "$pr_pid" 2>/dev/null && [ "$hold" -lt 5 ]; do sleep 1; hold=$((hold + 1)); done
    kill -KILL "$pr_pid" 2>/dev/null || true
  fi
  # The rendered config is PER RUN (`.pragent.settings.<pid>.toml`), so this run owns it and removes it:
  # leaving it would accumulate one credential-bearing file per run, and nothing else would ever delete it.
  # The copy at the fixed name is the only one that survives, which is what it is for.
  if [ -n "${rendered_cfg:-}" ]; then rm -f "$rendered_cfg"; fi
  archive_run
}
trap cleanup EXIT

# BEFORE the snapshot below, not only at the render. Staging runs `git add -A` on the reviewed tree, so a
# config dir inside this repository whose credential files are not ignored there would be hashed into
# .git/objects - where it stays, reachable by `git cat-file`, long after the render refuses the run. The
# renderer checks again (it is the only place that knows the render's own name), so a caller that skips
# this still refuses; this is here so the refusal comes before anything is written.
__preflight_load_settings_render || exit $?
__preflight_refuse_in_repo_config "$cfgdir" || exit $?

if [ "$scope" = 'head' ]; then
  diff_ref="${base}...HEAD"
else
  idxf="$(mktemp)"; rm -f "$idxf"
  GIT_INDEX_FILE="$idxf" git read-tree HEAD
  GIT_INDEX_FILE="$idxf" git add -A
  tree="$(GIT_INDEX_FILE="$idxf" git write-tree)"
  # This tree is the exact content handed to pr-agent, so it is the record the commit hook compares
  # against. The hook's containment check is unchanged by the scope: it compares every path being
  # committed against this tree.
  hook_tree="$tree"
  if [ "$scope" = 'commit' ]; then
    # `diff HEAD` alone sees only TRACKED changes, so a new file would never be reviewed while still
    # being in reviewed_tree - and the hook, which compares against it, would then accept the
    # unreviewed file. Diffing against the tree is what makes "everything a commit would contain" true.
    diff_ref="$tree"
    diff_base='HEAD'
  else
    synth="$(GIT_AUTHOR_NAME=preflight GIT_AUTHOR_EMAIL=preflight@localhost \
              GIT_COMMITTER_NAME=preflight GIT_COMMITTER_EMAIL=preflight@localhost \
              git -c commit.gpgsign=false commit-tree "$tree" -p HEAD -m 'preflight worktree snapshot')"
    diff_ref="${base}...${synth}"
  fi
fi

# Rendered AFTER the working-tree snapshot above, so the file it writes is never in the diff the review is
# handed. The in-repo guard already ran before that snapshot; the renderer runs it again over the render's
# own name, which only it knows.
# A missing settings.toml means there is no model and no review, and the renderer prints that refusal: it
# is the one place that knows which of the two files is absent, so the wording cannot drift between here
# and the sibling helper.
__preflight_render_settings "$cfgdir" "${root:-}" || exit $?
rendered_cfg="$PREFLIGHT_RENDERED_CONFIG"

case "$cmd" in
  review|review_pr)     out_md="$dir/review.md";      out_json="$dir/review.json" ;;
  describe|describe_pr) out_md="$dir/description.md"; out_json='' ;;
  improve|improve_code) out_md="$dir/improve.md";     out_json='' ;;
  ask|ask_question)     out_md="$dir/answer.md";      out_json='' ;;
  *) echo "preflight-code: unknown command '$cmd' (use review|describe|improve|ask; 'preflight-code --help' for the full list)" >&2; exit 2 ;;
esac

mkdir -p "$dir"
begin_run
# The config pr-agent reads: ALWAYS the rendered file. settings.toml and providers.toml are the only
# sources, so there is no second config to fall back to - `__preflight_render_settings` refuses when it
# cannot produce one, and that refusal stops the run before here.
cfg="$rendered_cfg"
if [ "$scope" = 'commit' ]; then
  echo "preflight-code: ${cmd} (scope=commit) — pending change since HEAD -> ${dir}/" >&2
else
  echo "preflight-code: ${cmd} (scope=${scope}) — $(git rev-parse --abbrev-ref HEAD) vs ${base} -> ${dir}/" >&2
fi

# Reviewer context from AGENTS.md. pr-agent's own `repo_context_files` cannot serve this: its
# plain-diff provider implements neither `get_repo_file_content` nor `get_repo_context_ref`, so
# `build_repo_context` returns empty on our stdin path. The `[artifacts]` mechanism does reach the
# reviewer, and is what carries the file.
#
# A `Code review` section, when the file has one, is the whole of what is sent - so a repository can
# keep a long AGENTS.md for agents and a bounded block for the reviewer. With no such section the
# whole file is sent, because AGENTS.md is the converged cross-tool convention and how much of it to
# hand over is the repository's own choice, not the harness's.
#
# Read from the WORKING TREE, not the base branch - deliberately the opposite of what pr-agent and
# Codacy do with `.pr_agent.toml`, which they read from the default branch so a PR cannot edit its own
# reviewer instructions. This is a local pre-commit harness: the file is committed, so it is part of
# the diff under review and a change to it is reviewable. Repo-controlled in the same way
# `.preflight.toml` is, and not a boundary against an untrusted repository.
context_note='none'
if [ "$cmd" = 'review' ] || [ "$cmd" = 'review_pr' ]; then
  # Relative to the repository root, because the helper cd's there (`root=` / `cd "$root"`) before any
  # path is resolved. No resolution of our own here: a second one would be dead code that hides the real
  # dependency, and removing the `cd` would silently change which file is found.
  # PREFLIGHT_CONTEXT_FILE can name a different file, relative or absolute.
  ctx_file="${PREFLIGHT_CONTEXT_FILE:-AGENTS.md}"
  if [ -f "$ctx_file" ]; then
    # The extractor reports which mode it used on stdout, so the summary line cannot claim a section
    # the extractor did not find: one heading match decides both.
    ctx_mode=''
    if ctx_mode="$(python3 - "$ctx_file" "$dir/context.md" <<'PY'
import re, sys

def atx_headings(text):
    """ATX headings OUTSIDE fenced code blocks, as (level, title, start, end).

    Fence-awareness is not cosmetic: a shell comment at column 0 inside a fenced block, or a fenced
    example containing a heading, would otherwise be read as the section boundary - ending the section
    early and silently dropping the facts after it, which is the failure this context exists to prevent.
    """
    out = []
    fence = None
    off = 0
    for line in text.splitlines(keepends=True):
        f = re.match(r'[ \t]*(`{3,}|~{3,})(.*)$', line.rstrip('\r\n'))
        if f:
            run, rest = f.group(1), f.group(2)
            ch, n = run[0], len(run)
            # CommonMark: a CLOSING fence carries nothing but spaces or tabs after the run. A fence line
            # with an info string is therefore CONTENT, so an example that shows a tagged fence does not
            # end the block early - which would expose a heading-looking line inside it and truncate the
            # section. An info string on a backtick fence may not itself contain a backtick, so such a
            # line opens nothing either.
            if fence is None:
                if not (ch == '`' and '`' in rest):
                    fence = (ch, n)
            elif rest.strip() == '' and ch == fence[0] and n >= fence[1]:
                fence = None
            off += len(line)
            continue
        if fence is None:
            # CommonMark, so the section boundary agrees with what a reader sees: up to three leading
            # spaces, then the hashes, then a space or end of line (without which a column-0
            # `#!/bin/sh` or `#hashtag` would read as a heading and silently end the section), then the
            # title, then an optional closing run of hashes. The fence scan above already allows leading
            # whitespace, so anchoring at column 0 here would make the two disagree.
            # (No UNPAIRED apostrophe in this heredoc - a contraction or possessive written as text.
            # Paired ones, like the Python string delimiters, are fine. The body sits inside `$( )`,
            # which bash 3.2 - what macOS ships - mis-parses when an apostrophe is left unpaired.
            # See AGENTS.md.)
            h = re.match(r'^ {0,3}(#{1,6})(?:[ \t]+(.*?))?[ \t]*#*[ \t]*$', line.rstrip('\r\n'))
            if h:
                # A bare `#` or `##` is a valid empty heading, so the title group is None, not ''.
                out.append((len(h.group(1)), h.group(2) or '', off, off + len(line)))
        off += len(line)
    return out

text = open(sys.argv[1], encoding='utf-8', errors='replace').read()
headings = atx_headings(text)
mode = 'whole'
body = text
for level, title, _start, end in headings:
    # A heading whose TEXT starts with "Code review", at any level. The body itself is matched on nothing.
    if re.match(r'code review\b', title, re.I):
        stop = len(text)
        for l2, _t2, s2, _e2 in headings:
            if s2 >= end and l2 <= level:
                stop = s2          # the next heading of the same or a higher level ends the section
                break
        body, mode = text[end:stop], 'section'
        break
with open(sys.argv[2], 'w', encoding='utf-8') as fh:
    fh.write(body.strip() + '\n')
print(mode)
