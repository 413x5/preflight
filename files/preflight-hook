#!/bin/sh
# preflight-hook — verify that what is being committed has already been reviewed.
#
# Called by a repo's committed .githooks/pre-commit (see the preflight bundle docs). It is
# READ-ONLY: it never modifies the index, HEAD or the working tree, and it never runs a review
# (a review cannot be graded before the commit it describes exists).
#
# It answers one question: does the content being committed match the content that was reviewed?
# Anything being committed that the reviewer never saw blocks the commit.
#
# Exit: 0 = the commit may proceed | 1 = blocked (run 'preflight review', then commit again)
#
# Env:  PREFLIGHT_DIR   artifact dir (default .preflight)
#       PREFLIGHT_SKIP=1 bypass once (same idea as 'git commit --no-verify')
set -u

[ "${PREFLIGHT_SKIP:-0}" = "1" ] && exit 0

dir="${PREFLIGHT_DIR:-.preflight}"

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

fail() {
  printf 'preflight: commit blocked: %s\n' "$1" >&2
  printf "preflight: run 'preflight review', then commit again.\n" >&2
  exit 1
}

# Fail closed on a missing interpreter rather than silently passing an unverified commit.
command -v python3 >/dev/null 2>&1 || fail "python3 is required to read the review sidecar"

# A repository with no commits has nothing to protect: the commit being made *is* the initial
# content, and `preflight review` cannot run at all before a first commit exists (it needs HEAD to
# diff against). Blocking here would deadlock adoption - the hook could never be installed before
# the commit that installs it. Allow it and say so.
git rev-parse --verify -q HEAD >/dev/null 2>&1 || {
  printf 'preflight: not enforced: this repository has no commits yet.\n' >&2
  printf "preflight: run 'preflight review' after this first commit to enforce later ones.\n" >&2
  exit 0
}

meta="$dir/review.meta.json"
[ -f "$meta" ] || fail "no review found for this repo"

# Read the sidecar written by `preflight review`. Prints shell assignments; empty on any problem.
assignments=$(python3 - "$meta" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        d = json.load(fh)
except Exception:
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
def q(v):
    return "'" + str(v if v is not None else '').replace("'", "'\\''") + "'"
gate = d.get('gate') if isinstance(d.get('gate'), dict) else {}
print('pf_scope='   + q(d.get('scope')))
print('pf_tree='    + q(d.get('reviewed_tree')))
print('pf_verdict=' + q(gate.get('verdict')))
PY
)
[ -n "$assignments" ] || fail "could not read $meta"
eval "$assignments"

# A head-scope review covers already-committed content, which cannot be graded before the *next*
# commit exists. Say so plainly rather than pretending to enforce it. Checked before the tree,
# because a head-scope sidecar deliberately records no reviewed tree.
# Both `commit` and `worktree` reviews record a reviewed_tree, so both can be enforced. `commit` is the
# default: it reviews exactly what a commit would contain (HEAD -> working tree). `head` records no tree -
# it reviews already-committed content, which cannot be graded before the *next* commit exists - so it is
# reported rather than enforced.
case "${pf_scope:-}" in
  commit|worktree) ;;
  *)
    printf 'preflight: not enforced: the last review used scope=%s (hook enforcement needs commit or worktree scope).\n' "${pf_scope:-unknown}" >&2
    printf "preflight: run 'preflight review' with the default scope to enforce commits.\n" >&2
    exit 0
    ;;
esac

[ -n "${pf_tree:-}" ] || fail "the review sidecar does not name a reviewed tree"

[ "${pf_verdict:-}" = "pass" ] || fail "the last review did not pass (${pf_verdict:-unknown})"

# The binding is purely CONTENT-based, deliberately. There is no check that the review's recorded
# head equals HEAD: committing moves HEAD, so such a check would invalidate the sidecar after every
# commit and would forbid splitting one reviewed change across commits - while adding nothing, since
# any real content change is already caught by the comparison below.
staged=$(git write-tree 2>/dev/null) || fail "could not read the staged tree"

# Containment: every path being committed must match the reviewed tree. The comparison is read
# REVIEWED -> STAGED, and each status means something specific about the commit being made:
#
#   A / M   added or modified relative to what was reviewed - unreviewed content.
#   R       renamed. With rename detection on, a moved file is neither A nor M, so it has to be
#           named explicitly: renaming a guard file away leaves it present but no longer invoked,
#           which is a real change the reviewer never saw.
#   T       a changed file type (regular file -> symlink or submodule, and the reverse). Contents
#           can stay identical while the meaning changes completely.
#   C       copied.
#   D       in the reviewed tree but not in the staged tree, so reviewed content is going away. That
#           is how a guard gets deleted without being noticed, so it is blocked too.
#
# The filter therefore has to be ACMRTU rather than AM. AM silently missed R and T - a renamed or
# type-changed reviewed path passed unreviewed.
#
# D needs one refinement. An untracked scratch file is in the reviewed tree (the snapshot includes
# untracked files) and not in the staged tree, so it also shows up as D - and blocking that would
# break `git commit -a`, which is exactly what this rule exists to preserve. The difference is
# whether the path is tracked in HEAD: a D path that HEAD knows is tracked content genuinely being
# deleted, while a D path that HEAD does not know was never part of the commit's history and is
# simply not being committed. Only the former is a real change.
#
# Every listing here uses `-z`, and the paths are handled as raw bytes. `--name-only` without `-z`
# QUOTES any path that needs it - enclosing it in double quotes and backslash-escaping it - and
# `core.quotePath` cannot turn that off for the characters that matter (it only controls bytes
# above 0x7f). Feeding a quoted name back into git asks about a path that does not exist, so a
# reviewed tracked file named `a"b.py`, `c\d.py` or `café.py` was mistaken for an untracked scratch
# file and its deletion committed unreviewed. `-z` emits the raw name, NUL-terminated.
tmpd=$(mktemp -d) || fail "could not create a temporary directory"
trap 'rm -rf "$tmpd"' EXIT
trap 'rm -rf "$tmpd"; exit 1' HUP INT TERM

git diff-tree -r -M -z --diff-filter=ACMRTU --name-only "$pf_tree" "$staged" \
  >"$tmpd/changed" 2>/dev/null || fail "could not compare the reviewed and staged trees"
git diff-tree -r -M -z --diff-filter=D --name-only "$pf_tree" "$staged" \
  >"$tmpd/removed" 2>/dev/null || fail "could not compare the reviewed and staged trees"
# `ls-tree -r -z` WITHOUT `--name-only`: the latter only exists from git 2.38, and nothing else here
# needs a git that new. Each record is "<mode> <type> <sha>\t<name>", so splitting on the FIRST tab is
# unambiguous - with -z the name is raw and may itself contain a tab.
git ls-tree -r -z HEAD >"$tmpd/tracked" 2>/dev/null \
  || fail "could not read the tracked paths at HEAD"

python3 - "$tmpd/tracked" "$tmpd/removed" "$tmpd/deleted" <<'PY' || fail "could not compare the reviewed and staged trees"
import sys

def readz(path):
    with open(path, 'rb') as fh:
        return [n for n in fh.read().split(b'\0') if n]

# Records are "<mode> <type> <sha>\t<name>"; keep only the name.
tracked = {rec.split(b'\t', 1)[1] for rec in readz(sys.argv[1]) if b'\t' in rec}
with open(sys.argv[3], 'wb') as out:
    out.write(b''.join(n + b'\0' for n in readz(sys.argv[2]) if n in tracked))
PY

if [ -s "$tmpd/changed" ] || [ -s "$tmpd/deleted" ]; then
  printf 'preflight: commit blocked: these paths changed after the review:\n' >&2
  python3 - "$tmpd/changed" "$tmpd/deleted" <<'PY' >&2
import sys

def show(path, prefix):
    with open(path, 'rb') as fh:
        for name in fh.read().split(b'\0'):
            if name:
                sys.stdout.buffer.write(b'  ' + prefix + name + b'\n')

show(sys.argv[1], b'')
show(sys.argv[2], b'(deleted) ')
PY
  printf "preflight: run 'preflight review', then commit again.\n" >&2
  exit 1
fi
exit 0
