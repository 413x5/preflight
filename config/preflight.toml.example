# preflight config — a HOST-side PR-Agent layer, loaded via --extra_config_url.
#
# Any OpenAI-compatible endpoint works; these values are the ClinePass defaults the bundle was built
# for. install.sh overrides them all: PREFLIGHT_MODEL, PREFLIGHT_FALLBACK_MODELS,
# PREFLIGHT_CUSTOM_MODEL_MAX_TOKENS, PREFLIGHT_MAX_MODEL_TOKENS, PREFLIGHT_FORCE_STREAMING_HOST.
#
# Why each value is what it is: docs/architecture.md. History: CHANGELOG.md.
[config]
model = "openai/cline-pass/deepseek-v4.1-flash"
# An id your endpoint serves, in its own provider/model form ([] disables fallback).
fallback_models = ["openai/cline-pass/glm-5.3-flash"]
# Required when the model is absent from LiteLLM's table (as cline-pass/* is), or nothing declares the
# context window and the packing clamp cuts it to 32k. 0 = let LiteLLM resolve it.
custom_model_max_tokens = 1000000
max_model_tokens = 1000000
output_run_details = true

[litellm]
# CLINEPASS-SPECIFIC, matched against api_base so it is inert for other endpoints: this host's
# non-streaming envelope cannot be normalized by LiteLLM, its streaming returns standard SSE.
force_streaming_custom_llm_provider = "openai"
force_streaming_api_base_substrings = ["api.cline.bot"]
custom_llm_provider = "openai"

[pr_reviewer]
# Upstream is 3, which makes an agent fix 3 findings and discover 3 more on the next run.
num_max_findings = 20
require_merge_recommendation = true
# Chunking switches the token-budget fallback from "review a slice, drop the rest" to "split the diff
# and union the findings". max_number_of_calls bounds chunks SENT; beyond it, files appear only in the
# coverage footer that coverage=PARTIAL points at.
enable_large_pr_chunking = true
max_number_of_calls = 3
